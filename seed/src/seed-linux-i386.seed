ecx ERR_SP mov_rr,[aa]	\ ERR_SP in ecx
ecx push		\ save previous ERR_SP
ecx edx mov_rr,[rr]	\ previous handler address in ecx
ecx push		\ save previous handler address
edx push		\ save handler pointer
ERR_SP esp mov_[aa],rr  \ set new ERR_SP
binary			\ handler reference in ecx
edx ecx mov_[rr],rr	\ handler reference changed
x' execute call		\ execute code with effects
esp ERR_SP mov_rr,[aa]	\ stack to handler frame
ecx pop			\ handler ptr in ecx
edx pop			\ previous handler addr. in edx
ecx edx mov_[rr],rr	\ restore handler
ecx pop
ERR_SP ecx mov_[aa],rr	\ restore ERR_SP
esp xcell add_rr,s	\ discard data stack pointer
ret

