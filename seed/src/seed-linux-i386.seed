\ Beginning of cross-compilation
create ELF

0 org

\ Signature
7F c, ascii E c, ascii L c, ascii F c,

\ Class 1, 32-bit
1 c,

\ Little-endian
1 c,

\ ELF version
1 c,

\ OS ABI
0c,

\ Extended ABI
0 q,

\ e_type: Elf file type (ET_EXEC = 2, executable)
2 w,

\ e_machine: Target architecture (EM_386 = 3, i386)
3 w,

\ e_version: Additional ELF version
1 d,

\ e_entry: Entry point, lower 16 bits
f_EntryPoint field
\ and the remaining 16 bits; the virtual address is 0x001xxxx
0 w, ximage_base_hi w,

\ e_phoff: file offset of the program headers
f_ProgramHeaders field
0 d,

\ e_shoff: file offset of the section headers
0 d,

\ e_flags: unused
0 d,

\ e_ehsize: size of this elf header (struct ELF32_Ehdr)
34 w,

\ e_phentsize: size of program header entry
20 w,

\ e_phnum: Number of program header entries
1 w,

\ e_shentsize: Section header entry size
0 w,

\ e_shnum: Number of section header entries
0 w,

\ e_shstrndx: Index of string table section
0 w,

\
\ Program Headers
\

$ f_ProgramHeaders @ w!

\ p_type: program header type (PT_LOAD = 1)
1 d,

\ p_offset: loadable segment offset in the file
0 d,

\ p_vaddr: Virtual address, i.e. 10000
0 w, ximage_base_hi w,

\ p_paddr: Physical address (ignored)
0 w, ximage_base_hi w,

\ p_filesz: size in file
f_SizeInFile field
0 d,

\ p_memsz: size in memory
0 w, 1 w,

\ p_flags: program header flags: 7 = read + write + execute
7 d,

\ p_align: alignment
1000 d,

\
\ Emit the machine code
\

$ f_EntryPoint @ w!

7 jmp_f \ jump over the initial dictionary

0 label! \ get heap top
sys.brk syscall
ret

1 label! \ low-level heap allocation of ecx bytes
eax push
ecx push
edi 0 mov_rr,x
0 label call
ecx pop
ecx DP add_rr,[aa]
eax ecx cmp_rr,rr
2 jnc_fs
edi ecx mov_rr,rr
0 label call
edi DICTIONARY mov_rr,[aa] \ beginning of heap
eax edi sub_rr,rr	\ calculate length of heap
ecx eax mov_rr,rr	\ move length to ecx
edx 7 mov_rr,x		\ PROT_READ + PROT_WRITE + PROT_EXEC
sys.mprotect syscall
2 rlabel_fs!
eax pop
ret

native callcomp
$ callcomp !
ecx 5 mov_rr,x
1 label call
ecx DP mov_rr,[aa]
ecx E8 mov_byte_[rr],x \ call
2 label!
ecx inc_rr
eax ecx sub_rr,rr
eax 4 sub_rr,s
ecx eax mov_[rr],er
ecx 4 add_rr,s
DP ecx mov_[aa],rr
tos_load
ret

x' callcomp does

native tailcomp
ecx 5 mov_rr,x
1 label call
ecx DP mov_rr,[aa]
ecx E9 mov_byte_[rr],x \ jmp
2 label jmp

native endcomp
$ endcomp !
x' tailcomp call
2 jmp_f

native }~fail
2 rlabel_f!
2 label!
ecx FAIL mov_rr,aa
3 label!
esp ERR_SP mov_rr,[aa]	\ restore esp
edx pop			\ handler pointer in edx
ecx edx cmp_rr,rr	\ compare with current effect's
ebx pop			\ ebx = previous handler address
eax edx mov_rr,[rr]
edx ebx mov_[rr],rr	\ restore previous handler address
ebx eax mov_rr,rr	\ ebx = current handler address
eax pop			\ eax = previous ERR_SP
ERR_SP eax mov_[aa],rr	\ restore previous ERR_SP
3 label jnz_s		\ next handler, if not found
ecx ebx mov_rr,rr	\ ecx = current handler address
ebx pop			\ restore data stack pointer
eax ebx mov_rr,[rr]	\ restore TOS
ecx jmp_rr		\ continue with handler

x' endcomp does

native carry?
2 label jc
ret

