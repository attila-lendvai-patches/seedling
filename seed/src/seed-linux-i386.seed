output \ this must be on the first line

\ This is the Seed source for i386 Linux

\ Requirements
\ It can be compiled by any Seed that has at least 16 bit
\ cells and about 20 kilobytes of free RAM space available.

\ Assembler
\ This implements a very limited subset of the i386
\ assembly language and is only suited for compiling
\ code that lives in the virtual address range between
\ 10000 and 17FFF inclusive.

\ Glossary
\ TOS: top of stack

\ Imlementation
\ EAX holds TOS, the top element of the data stack
\ EBX points to the data stack (but top element is in EAX)
\ ECX is a scratch register
\ ESP is the call stack

hex

\ [port] IMAGE BASE
\ The target image is loaded at 10000 and must stay below 18000
\ (the system variables). Absolute addresses are 0001xxxx, so
\ their high 16 bits are 1. Keep this a 16-bit-safe literal:
\ a 16-bit Seed must be able to build this source.
1 constant ximage_base_hi

\ Auxiliary functions for the Assembler

\ execute n times
{: times ( x n -- )
{ 0<> 1- >r dup >r execute r> r> }~self
{ drop }~ drop
}~|

\ extract least significant 8 bits
{: lsb		dup 8 rshift swap FF and }

\ Heap manipulation words for the assembler
\ note, that it should work on both little-endian and
\ big-endian architectures, with various cell sizes.

\ 16-bit little-endian comma
{: w,		lsb c, c, }

\ 32-bit little-endian comma
{: d,		{ lsb c, } 3 times c, }

\ 8-byte little-endian comma
{: q,		{ lsb c, } 7 times c, }

\ 32-bit virtual address comma
{: a,		w, ximage_base_hi w, }

\ 16-bit little-endian fetch
{: w@		dup c@ swap 1+ c@ 8 lshift or }

\ 16-bit little-endian store
{: w!		dup >r 1+ >r lsb swap r> c! r> c! }

\ dump the tail of the heap for outputting the result
{: dump		here over - write drop }

\ Offset between host and target addresses
0 variable offset

\ Assembler directives
{: $		here offset @ - }
{: org		here swap - offset ! }
{: align	{ dup $ swap 1- and 0<> drop 0 c, }~self ' drop }~|

\ Labels

\ 8 labels must be enough
create labels
8 cells allot

\ Labels can be forward/backward, short/long, and
\ relative/absolute.
\
\ Forward labels: _f suffix.
\
\ Short labels: _s suffix. Their distance must be within
\ (-128..127). Note that the _sf suffix combination is also
\ possible.
\
\ Relative labels: 'r' prefix in their name.
\
\ Backward labels: at the point when they are needed their
\ address is already known. We just store the current address
\ when they are defined, and read it from the label_cell when
\ they are needed.
\
\ Forward labels are trickier: we store the location where the
\ address of the future label is needed (typically as a
\ component of a machine code instruction), and when the point
\ is reached in the emission where we should point to, then the
\ label-defining counterpart will emit the address (or offset)
\ into the previously registered location. Important corollary:
\ forward labels can only have one reference to them.

\ label cell address
{: label_cell	cells labels + }

\
\ Backward labels
\

\ Store current address into a label
{: label!	$ swap label_cell ! }

\ Backward label address (absolute)
{: label	label_cell @ }

\ Emit a relative jump offset (backward)
{: rlabel	$ 4 + - w, FFFF w, }
{: rlabel_s	$ 1+ - c, }

\
\ Forward labels
\

\ Register relative offset location
{: rlabel_f	here swap label_cell ! 0 d, }
{: rlabel_fs	here swap label_cell ! 0 c, }

\ Fill in relative offset
{: rlabel_f!	label dup here swap - 4 - swap w! }
{: rlabel_fs!	label dup here swap - 1- swap c! }

\ Register a 32 bit absolute forward location. Because we can
\ only assume 16 bit words in our host, we write out the upper
\ half of the 0x0001xxxx absolute base address, and store the
\ location of the lower half to be emitted by our label_f!
\ counterpart later.
{: label_f	here swap label_cell ! 0 w, ximage_base_hi w, }

\ Emit absolute forward label (only the lower 16 bits of it!)
{: label_f!	label_cell @ $ swap w! }

\ multiply by 8
{: 8*		3 lshift }

\ registers
0 constant eax
1 constant ecx
2 constant edx
3 constant ebx
4 constant esp
5 constant ebp
6 constant esi
7 constant edi

\ Opcodes

{: mov_rr,x		swap B8 + c, d, }
{: mov_rr,aa		swap B8 + c, w, 1 w, }
{: mov_rr,rr		89 c, 8* + C0 or c, }
{: mov_rl,rl		88 c, 8* + C0 or c, }
{: mov_er,er		89 c, 8* + C0 or c, }
{: mov_byte_[rr],x      C6 c, swap c, c, }
{: mov_[rr],rr		89 c, 8* + c, }
{: mov_[rr],er		89 c, 8* + c, }
{: mov_er,[rr]		8B c, swap 8* + c, }
{: mov_[rr],rl		88 c, 8* + c, }
{: mov_rl,[rr]		8A c, swap 8* + c, }
{: mov_rr,[rr]		8B c, swap 8* + c, }
{: mov_[aa],rr		89 c, 8* 4 + c, 25 c, w, 1 w, }
{: mov_[aa],rl		88 c, 8* 4 + c, 25 c, w, 1 w, }
{: mov_rl,[aa]		8A c, swap 8* 4 + c, 25 c, w, 1 w, }
{: mov_rr,[aa]		8B c, swap 8* 4 + c, 25 c, w, 1 w, }
{: int_x		CD c, c, }
{: add_rr,rr		01 c, 8* + C0 or c, }
{: add_rr,s		83 c, swap C0 + c, c, }
{: add_rr,[aa]		03 c, swap 8* 4 + c, 25 c, w, 1 w, }
{: sub_rr,s		83 c, swap E8 + c, c, }
{: sub_rr,rr		29 c, 8* + C0 or c, }
{: sbb_rr,rr		19 c, 8* + C0 or c, }
{: cmp_rr,s		83 c, swap F8 + c, c, }
{: cmp_rr,rr		39 c, 8* + C0 or c, }
{: cmp_rr,[rr]		3B c, swap 8* + c, }
{: cmp_rl,[rr]		3A c, swap 8* + c, }
{: and_rr,rr		21 c, 8* + C0 or c, }
{: or_rr,rr		09 c, 8* + C0 or c, }
{: xor_rr,rr		31 c, 8* + C0 or c, }
{: call			E8 c, rlabel }
{: call_f		E8 c, rlabel_f }
{: call_rr		FF c, D0 or c, }
{: jmp			E9 c, rlabel }
{: jmp_s		EB c, rlabel_s }
{: jmp_f		E9 c, rlabel_f }
{: jmp_[aa]		FF c, 24 c, 25 c, w, 1 w, }
{: jmp_rr		FF c, E0 or c, }
{: jc_s			72 c, rlabel_s }
{: jb_s			}~ jc_s
{: jnc_s		73 c, rlabel_s }
{: jae_s		}~ jnc_s
{: jz_s			74 c, rlabel_s }
{: jnz_s		75 c, rlabel_s }
{: jbe_s		76 c, rlabel_s }
{: ja_s			77 c, rlabel_s }
{: js_s			78 c, rlabel_s }
{: jns_s		79 c, rlabel_s }
{: jc_fs		72 c, rlabel_fs }
{: jnc_fs		73 c, rlabel_fs }
{: jz_fs		74 c, rlabel_fs }
{: jnz_fs		75 c, rlabel_fs }
{: js_fs		78 c, rlabel_fs }
{: jns_fs		79 c, rlabel_fs }
{: jc			0F c, 82 c, rlabel }
{: jb			}~ jc
{: jnc			0F c, 83 c, rlabel }
{: jae			}~ jnc
{: jz			0F c, 84 c, rlabel }
{: jnz			0F c, 85 c, rlabel }
{: jbe			0F c, 86 c, rlabel }
{: ja			0F c, 87 c, rlabel }
{: js			0F c, 88 c, rlabel }
{: jns			0F c, 89 c, rlabel }
{: jl			0F c, 8C c, rlabel }
{: jge			0F c, 8D c, rlabel }
{: jle			0F c, 8E c, rlabel }
{: jg			0F c, 8F c, rlabel }
{: ret			C3 c, }
{: push			50 + c, }
{: pop			58 + c, }
{: inc_rr		FF c, C0 or c, }
{: dec_rr		FF c, C8 or c, }
{: clc			F8 c, }
{: stc			F9 c, }
{: cld			FC c, }
{: std			FD c, }
{: shl_rr,s		C1 c, swap E0 or c, c, }
{: shr_rr,s		C1 c, swap E8 or c, c, }
{: shl_rr,cl		D3 c, E0 or c, }
{: shr_rr,cl		D3 c, E8 or c, }
{: sar_rr,cl		D3 c, F8 or c, }
{: rcr_rr,1		D1 c, D8 or c, }
{: rep_movsq		F3 c, A5 c, }
{: rep_movsb		F3 c, A4 c, }
{: cmpsb		A6 c, }
{: mul_rr		F7 c, E0 or c, }
{: div_rr		F7 c, F0 or c, }
{: idiv_rr		F7 c, F8 or c, }
{: not_rr		F7 c, D0 or c, }
{: neg_rr		F7 c, D8 or c, }

\ syscall

3  constant sys.read
4  constant sys.write
7D constant sys.mprotect
2D constant sys.brk
1  constant sys.exit

{: syscall ( n -- )
ebx push
ebx edi mov_rr,rr
eax swap mov_rr,x
  80 int_x
ebx pop
}

\ Cross Compilation
\ The Seed language cannot be directly cross-compiled,
\ because the compile mode behavior of the newly defined
\ words cannot be executed on the host architecture.
\ However, there is only a handful of words with compile
\ mode behavior that differs from default, so we can
\ write those behaviors in host Seed and look them up from
\ an association list.

\ assembler macros

\ [port] TARGET GEOMETRY
\ Values describe the target, not the compiling Seed. Offsets
\ are in target bytes; the host may have a different cell size.
\
\   xcell_bits  target cell size in bits
\   xcelllog    log2(xcell); used by xcells
\   xcell       target cell size in bytes
\   xcell1-     xcell - 1
\   xcell_mask  align-up mask
\   xcells      ( n -- n*xcell )
\   xalign      ( a -- a' ) align address up to a cell
\   xcell+      ( a -- a+xcell )
\
\ Word entry layout (entry = link cell; 'current' points here):
\   +0              link
\   +xcell          token / xt (code address)
\   +2 cells        compile-mode behavior
\   +3 cells        zero-terminated name
\   code ...        no instruction alignment on x86
\
\ Absolute addresses are 0001xxxx (image base 10000).
\ xword_comp is the compile-behavior field offset.
\ xname_from_token is the name offset from the token cell.
\ xrel_size is the width of a relative branch
\ displacement field.
20 constant xcell_bits          \ 32 bits
2  constant xcelllog            \ for shifts
xcell_bits 3 rshift constant xcell
xcell 1 - constant xcell1-      \ 3
xcell1- invert constant xcell_mask      \ FFFC
{: xcells  xcelllog lshift }
{: xalign  xcell1- + xcell_mask and }
{: xcell+  xcell + }

xcell 2 * constant xword_comp
xcell 2 * constant xname_from_token
4 constant xrel_size

{: tos_load             \ top of data stack -> eax
ebx xcell sub_rr,s
eax ebx mov_rr,[rr]
}

{: tos_store            \ eax -> data stack
ebx eax mov_[rr],rr
ebx xcell add_rr,s
}

{: binary
ecx eax mov_rr,rr
tos_load
}

{: binary_cmp
binary
eax ecx cmp_rr,rr
}

\ pointer to cross-compiled vocabulary
create xcurrent 0 w,

{: xlink ( a -- a )
xcell align
{ 0<> $ swap }~ a,
{ $ swap }~ d,
}~|

{: xlast ( -- a )
xcurrent }~ w@

{: xtraverse& ( a -( fail pend )- a )
w@ 0<>
offset @ +
'self &
dup
xcell+
}

{: xsearch ( a -( pad fail )- a )
xtraverse& xname_from_token +
pad s= cut }~ nip

{: xfind ( -( pad fail )- a )
xcurrent xsearch xname_from_token }~ -

\ target tick
{: x'
word xfind }~ w@

