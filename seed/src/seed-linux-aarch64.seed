X3 18 sub_rr,s		\ bottom of handler frame
X3 push		\ circular reference
X3 6 lb mov_rr,aa	\ this handler's address
X3 push		\ circular reference
X3 FAIL mov_rr,aa	\ failure handler
X3 push
ERR_SP mov_[aa],SP	\ set ERR_SP

\ initialize effects
X3 x' stdemit mov_rr,aa
EFFECTS X3 mov_[aa],rr
X3 x' stdwrite mov_rr,aa
EFFECTS 8 + X3 mov_[aa],rr
X3 x' stdkey mov_rr,aa
EFFECTS 10 + X3 mov_[aa],rr
X3 x' stdinput mov_rr,aa
EFFECTS 18 + X3 mov_[aa],rr
X3 x' stdok mov_rr,aa
EFFECTS 20 + X3 mov_[aa],rr

\ execute seed loop
x' seedl jmp

$ f_SizeInFile @ w!

ELF dump

bye
