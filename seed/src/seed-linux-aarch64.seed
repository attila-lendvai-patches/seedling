output \ this must be on the first line

\ This is the Seed source for aarch64 Linux

\ Requirements
\ It can be compiled by any Seed that has at least 16 bit
\ cells and about 20 kilobytes of free RAM space available.

\ Assembler
\ This implements a very limited subset of the AArch64
\ assembly language and is only suited for compiling
\ code that lives in the virtual address range between
\ 10000 and 17FFF inclusive.

\ Glossary
\ TOS: top of stack

\ Implementation
\ This port does not follow AAPCS64 internally; only the
\ Linux syscall ABI at SVC is followed. Register roles:
\   X0             TOS, the top element of the data stack
\   X19            data stack pointer (TOS lives in X0)
\   X3             scratch / second operand
\   X16, X17       scratch for addresses and instructions
\   X18            carry flag
\   X1, X2, X4, X5 scratch
\   X29            shadow call stack pointer; X30 is unused
\   SP             hardware stack pointer, 16-byte aligned
\ Syscalls take arguments in X0-X5, the number in X8, and
\ return in X0. The kernel preserves the other registers.
\
\ Helper contract: a helper called in the middle of a word
\ preserves X0, X18, X19, X29, and SP. X3 is preserved only
\ when the helper says so; X16 and X17 are scratch. Each
\ helper states any further clobbers and PSTATE effects.

hex

\ [port] IMAGE BASE
\ Image base: ximage_base_hi:low16(offset). The image must stay
\ below 18000 (the system variables), and no host value is wider
\ than 16 bits.
1 constant ximage_base_hi

\ [port] TARGET GEOMETRY (AArch64)
\ Values describe the target, not the compiling Seed. Offsets
\ are in target bytes; the host may have a different cell size.
\
\   xcell_bits  target cell size in bits
\   xcelllog    log2(xcell); used by xcells
\   xcell       target cell size in bytes
\   xcell1-     xcell - 1
\   xcell_mask  align-up mask
\   xcells      ( n -- n*xcell )
\   xalign      ( a -- a' ) align address up to a cell
\   xcell+      ( a -- a+xcell )
\   xcode_align_bytes instruction alignment in bytes
\
\ Word entry layout (entry = link cell; 'current' points here):
\   +0              link
\   +xcell          token / xt (code address)
\   +2 cells        compile-mode behavior
\   +3 cells        zero-terminated name
\   code ...        aligned to xcode_align_bytes
\
\ xword_comp is the compile-behavior field offset.
\ xname_from_token is the name offset from the token cell.
\ xcall_size is the size of the stack-call sequence.
\ xquote_open_size is the size of the quotation opener emitted
\ by x{{.
\ xrel_size is the width of a relative branch field.
40 constant xcell_bits          \ 64 bits
3  constant xcelllog            \ for shifts
xcell_bits 3 rshift constant xcell
xcell 1 - constant xcell1-      \ 7
xcell1- invert constant xcell_mask      \ FFF8
{: xcells  xcelllog lshift }
{: xalign  xcell1- + xcell_mask and }
{: xcell+  xcell + }

4 constant xcode_align_bytes
xcell 2 * constant xword_comp
xcell 2 * constant xname_from_token
10 constant xcall_size
10 constant xquote_open_size
4 constant xrel_size

\ Auxiliary functions for the Assembler

\ execute n times
{: times ( x n -- )
{ 0<> 1- >r dup >r execute r> r> }~self
{ drop }~ drop
}~|

\ extract least significant 8 bits
{: lsb		dup 8 rshift swap FF and }

\ Heap manipulation words for the assembler
\ note, that it should work on both little-endian and
\ big-endian architectures, with various cell sizes.

\ 16-bit little-endian comma
{: w,		lsb c, c, }

\ 32-bit little-endian comma
{: d,		{ lsb c, } 3 times c, }

\ 64-bit little-endian comma
{: q,		{ lsb c, } 7 times c, }

\ 64-bit virtual address comma
{: a,		w, ximage_base_hi w, 0 d, }

\ 16-bit little-endian fetch
{: w@		dup c@ swap 1+ c@ 8 lshift or }

\ 16-bit little-endian store
{: w!		dup >r 1+ >r lsb swap r> c! r> c! }

\ [port] emit/store a 32-bit value as two 16-bit words; a 16-bit
\ host cell cannot hold it whole; pass the halves apart.
\ ( low16 high16 -- )
{: x32,		swap w, w, }
\ ( low16 high16 addr -- )
{: x32!		>r swap r> dup 2 + >r w! r> w! }

\ dump the tail of the heap for outputting the result
{: dump		here over - write drop }

{: bit_size_to_mask ( bit_size -- mask )
  1 swap lshift 1-
}

\ Offset between host and target addresses
0 variable offset

\ Assembler directives
{: $		here offset @ - }
{: org		here swap - offset ! }
{: align	{ dup $ swap 1- and 0<> drop 0 c, }~self ' drop }~|

\ Labels

\ 16 labels must be enough
create labels
10 cells allot

\
\ Naming convention
\
\ Labels can be forward/backward, relative/absolute.
\
\ Backward labels: at the point when they are needed their
\ address is already known. We just store the current address
\ when they are defined, and read it from the label_cell when
\ they are needed.
\
\ Forward labels are trickier: we store the location where the
\ address of the future label is needed (typically as a
\ component of a machine code instruction), and when the point
\ is reached in the emission where we should point to, then the
\ label-defining counterpart will emit the address (or offset)
\ into the previously registered location. Important corollary:
\ forward labels can only have one reference to them.

\ label cell address
{: label_cell	cells labels + }

\
\ Backward labels
\

\ Store current address into a label
{: label	$ swap label_cell ! }

\ Backward label address to stack (absolute)
{: label@	label_cell @ }
{: lb		label@ }

\ Backward label offset, divided by 4 as the ISA expects. Split
\ into the low 16 bits and the sign bits above them; high_bits
\ and low_bits describe the destination field.
{: label_offset ( addr high_bits low_bits -- high_imm low16 )
  >r >r                 \ addr ; r: low_bits high_bits
  $ swap -              \ here-addr (backward distance)
  2 rshift              \ instruction offset, divided by 4
  0 swap -              \ signed instruction offset
  r> r>                 \ imm high_bits low_bits
  swap >r               \ imm low_bits ; r: high_bits
  over swap lshift      \ imm low16
  swap 8000 and F rshift \ low16 sign
  r> 10 swap - bit_size_to_mask
  * swap
}

\ Emit a relative jump offset (backward).
{: rlabel, ( offset_high16 offset high_opcode low_opcode -- )
  swap >r                       \ save high_opcode
  or w,                         \ write low
  r> or w,                      \ write high
}

\
\ Forward labels
\

\ Register relative offset location in the label until the
\ future definition of the label.
{: rlabel_f ( label -- )
  here swap label_cell !
}

\ Forward label offset, split into high and low halves.
\ The patch site holds the field's low-bit position.
{: label_offset_f ( place -- high_imm low16 )
  dup here swap - 2 rshift    \ place, offset/4
  swap c@ 0F and              \ offset, low_bits
  dup >r                      \ offset, low_bits ; r: low_bits
  over swap lshift            \ offset, low16
  swap                        \ low16, offset
  r> 10 swap - rshift         \ low16, high_imm
  swap
}

\ Fill in relative offset
{: rlabel_f!
  label@                      \ ds: place
  dup 2 + w@ >r               \ high_opcode
  dup 1 + c@ >r               \ low_opcode
  dup label_offset_f          \ place, offset_high16, offset
  r> or third w!              \ place, offset_high16
  r> or swap 2 + w!
}

{: rlabel rlabel_f! }

\ Register a 64 bit absolute forward location. Because we can
\ only assume 16 bit words in our host, we write out the upper
\ half of the 0x0001xxxx absolute base address, and store the
\ location of the lower half to be emitted by our label_f!
\ counterpart later.
{: label_f	here swap label_cell ! 0 w, ximage_base_hi w, 0 d, }

\ Emit absolute forward label (only the lower 16 bits of it!)
{: label_f!	label@ $ swap w! }

\ registers
0 constant X0
1 constant X1
2 constant X2
3 constant X3
4 constant X4
5 constant X5
6 constant X6
7 constant X7
8 constant X8
9 constant X9
A constant X10
B constant X11
C constant X12
D constant X13
E constant X14
F constant X15
10 constant X16
11 constant X17
12 constant X18
13 constant X19
14 constant X20
15 constant X21
16 constant X22
17 constant X23
18 constant X24
19 constant X25
1A constant X26
1B constant X27
1C constant X28
1D constant X29
1E constant X30
1F constant SP
1F constant XZR

\ Immediate construction

\ The imm16 field crosses the 16-bit boundary: its low 11 bits
\ are in the low half, its high 5 bits in the high half.
{: MOVZ_r,u16, ( reg imm -- )
  swap over FFFF and 5 lshift over or
  swap >r swap FFFF and B rshift D280 or
  x32, r> drop
}

{: MOVK_r,u16, ( reg imm -- )
  swap over FFFF and 5 lshift over or
  swap >r swap FFFF and B rshift F2A0 or
  x32, r> drop
}

{: mov_rr,x ( reg imm -- )
  swap
  over FFFF and 5 lshift over or
  swap >r swap FFFF and B rshift D280 or
  x32, r>
  0 5 lshift over or F2A0 x32,
  0 5 lshift over or F2C0 x32,
  0 5 lshift over or F2E0 x32,
  drop
}

{: mov_rr,aa ( reg addr -- )
  swap
  over FFFF and 5 lshift over or
  swap >r swap FFFF and B rshift D280 or
  x32, r>
  ximage_base_hi 5 lshift over or F2A0 x32,
  drop
}

\ Register to register operations

{: MOV_r,r, ( dst src -- )
  over 3E0 or swap AA00 or x32, drop
}

{: ADD_r,r, ( dst src -- )
  over dup 5 lshift or swap 8B00 or x32, drop
}

{: ADDS_r,r, ( dst src -- )
  over dup 5 lshift or swap AB00 or x32, drop
}

{: SUB_r,r, ( dst src -- )
  over dup 5 lshift or swap CB00 or x32, drop
}

{: SUBS_r,r, ( dst src -- )
  over dup 5 lshift or swap EB00 or x32, drop
}

{: AND_r,r, ( dst src -- )
  over dup 5 lshift or swap 8A00 or x32, drop
}

{: ORR_r,r, ( dst src -- )
  over dup 5 lshift or swap AA00 or x32, drop
}

{: ORRS_r,r, ( dst src -- )
  over dup 5 lshift or swap EA00 or x32, drop
}

{: EOR_r,r, ( dst src -- )
  over dup 5 lshift or swap CA00 or x32, drop
}

\ Register to immediate operations

{: ADD_r,s, ( reg imm -- )
  over dup 5 lshift or >r
  dup 6 rshift >r
  3F and A lshift
  r> 9100 or
  swap r> or
  swap x32, drop
}

{: ADDS_r,s, ( reg imm -- )
  over dup 5 lshift or >r
  dup 6 rshift >r
  3F and A lshift
  r> B100 or
  swap r> or
  swap x32, drop
}

{: SUB_r,s, ( reg imm -- )
  over dup 5 lshift or >r
  dup 6 rshift >r
  3F and A lshift
  r> D100 or
  swap r> or
  swap x32, drop
}

{: SUBS_r,s, ( reg imm -- )
  over dup 5 lshift or >r
  dup 6 rshift >r
  3F and A lshift
  r> F100 or
  swap r> or
  swap x32, drop
}

{: CMP_r,r, ( left right -- )
  over 5 lshift 1F or swap EB00 or x32, drop
}

{: CMP_r,s, ( reg imm -- )
  over 5 lshift 1F or >r
  dup 6 rshift >r
  3F and A lshift
  r> F100 or
  swap r> or
  swap x32, drop
}

\ Memory operations

{: LDR_r,[r], ( dst base -- )
  5 lshift swap or F940 x32,
}

{: STR_r,[r], ( base src -- )
  swap 5 lshift swap or F900 x32,
}

{: LDR_er,[r], ( dst base -- )
  5 lshift swap or B940 x32,
}

{: STR_er,[r], ( base src -- )
  swap 5 lshift swap or B900 x32,
}

{: LDR_rl,[r], ( dst base -- )
  5 lshift swap or 3940 x32,
}

{: STR_rl,[r], ( base src -- )
  swap 5 lshift swap or 3900 x32,
}

{: STRB_16,[r], ( base -- )
  5 lshift 10 or 3900 x32,
}
\ These move the call-stack pointer (X29), not the hardware SP:
\ SP must stay 16-byte aligned for the kernel.
{: mov_from_sp ( dst -- )
  3A0 or 9100 x32,
}

{: mov_to_sp ( src -- )
  5 lshift 1D or 9100 x32,
}

{: movSP,[aa] ( addr -- )
  X16 swap mov_rr,aa X17 X16 LDR_r,[r], X17 mov_to_sp
}

{: mov_[aa],SP ( addr -- )
  X16 swap mov_rr,aa X17 mov_from_sp X16 X17 STR_r,[r],
}

\ Basic x86-style macro names used by the rest of the source

{: mov_rr,rr ( dst src -- ) MOV_r,r, }
{: mov_rl,rl ( dst src -- ) MOV_r,r, }
{: mov_er,er ( dst src -- ) MOV_r,r, }

{: mov_[rr],rr ( base src -- ) STR_r,[r], }
{: mov_[rr],er ( base src -- ) STR_er,[r], }
{: mov_[rr],rl ( base src -- ) STR_rl,[r], }
{: mov_er,[rr] ( dst base -- ) LDR_er,[r], }
{: mov_rl,[rr] ( dst base -- ) LDR_rl,[r], }
{: mov_rr,[rr] ( dst base -- ) LDR_r,[r], }

{: mov_byte_[rr],x ( base imm -- )
  swap >r X16 swap MOVZ_r,u16, r> STRB_16,[r],
}

{: mov_[aa],rr ( addr src -- )
  >r X16 swap mov_rr,aa r> X16 swap mov_[rr],rr
}

{: mov_[aa],rl ( addr src -- )
  >r X16 swap mov_rr,aa r> X16 swap mov_[rr],rl
}

{: mov_rl,[aa] ( dst addr -- )
  X16 swap mov_rr,aa X16 LDR_rl,[r],
}

{: mov_rr,[aa] ( dst addr -- )
  X16 swap mov_rr,aa X16 LDR_r,[r],
}

{: add_rr,rr ( dst src -- ) ADD_r,r, }
{: add_rr,s ( reg imm -- ) ADD_r,s, }
{: add_rr,[aa] ( reg addr -- )
  swap >r X16 swap mov_rr,aa X16 X16 LDR_r,[r], r> X16 ADD_r,r,
}
{: sub_rr,s ( reg imm -- ) SUB_r,s, }
{: sub_rr,rr ( dst src -- ) SUB_r,r, }
{: sbb_rr,rr ( dst src -- )
  over dup 5 lshift or swap DA00 or x32, drop
}
{: adds_rr,rr ( dst src -- ) ADDS_r,r, }
{: adds_rr,s ( reg imm -- ) ADDS_r,s, }
{: subs_rr,rr ( dst src -- ) SUBS_r,r, }
{: subs_rr,s ( reg imm -- ) SUBS_r,s, }
{: cmp_rr,s ( reg imm -- ) CMP_r,s, }
{: cmp_rr,rr ( left right -- ) CMP_r,r, }
{: cmp_rr,[rr] ( left base -- )
  swap >r X16 swap LDR_r,[r], r> X16 CMP_r,r,
}
{: cmp_rl,[rr] ( reg base -- )
  swap >r X16 swap LDR_rl,[r], r> X16 CMP_r,r,
}
{: and_rr,rr ( dst src -- ) AND_r,r, }
{: or_rr,rr ( dst src -- ) ORR_r,r, }
{: xor_rr,rr ( dst src -- ) EOR_r,r, }

{: set_carry_add 37F2 9A9F x32, }
{: set_carry_sub 27F2 9A9F x32, }
{: set_carry_ne 07F2 9A9F x32, }

{: SVC 1 D400 x32, }
{: int_x SVC }

{: push ( reg -- ) 8FA0 or F81F x32, }
{: pop ( reg -- ) 87A0 or F840 x32, }

\ Instruction cache maintenance. Code written to the heap
\ must be cleaned to the point of unification and the
\ instruction cache invalidated before it can be executed.
{: DC_CVAU ( reg -- ) 7B20 or D50B x32, }
{: IC_IVAU ( reg -- ) 7520 or D50B x32, }
{: DSB_ISH 3B9F D503 x32, }
{: ISB 3FDF D503 x32, }
{: NOT_r,r, ( reg -- ) dup 3E0 or swap AA20 or x32, }

\ Branch instructions

{: B.   ( addr  -- ) 6 0 label_offset 1400 0 rlabel, }
{: BL   ( addr  -- ) 6 0 label_offset 9400 0 rlabel, }

{: cond_jump_instr
  8 5 label_offset 5400
}

{: B.EQ ( addr -- ) cond_jump_instr 0 rlabel, }
{: B.NE ( addr -- ) cond_jump_instr 1 rlabel, }
{: B.HS ( addr -- ) cond_jump_instr 2 rlabel, }
{: B.LO ( addr -- ) cond_jump_instr 3 rlabel, }
{: B.MI ( addr -- ) cond_jump_instr 4 rlabel, }
{: B.PL ( addr -- ) cond_jump_instr 5 rlabel, }
{: B.VS ( addr -- ) cond_jump_instr 6 rlabel, }
{: B.VC ( addr -- ) cond_jump_instr 7 rlabel, }
{: B.HI ( addr -- ) cond_jump_instr 8 rlabel, }
{: B.LS ( addr -- ) cond_jump_instr 9 rlabel, }
{: B.GE ( addr -- ) cond_jump_instr A rlabel, }
{: B.LT ( addr -- ) cond_jump_instr B rlabel, }
{: B.GT ( addr -- ) cond_jump_instr C rlabel, }
{: B.LE ( addr -- ) cond_jump_instr D rlabel, }

{: B._f   ( label -- ) rlabel_f A0 c, 0 c, 1400 w, }
{: BL_f   ( label -- ) rlabel_f A0 c, 0 c, 9400 w, }

{: cond_jump_instr_f, ( high_low_bits low_opcode -- )
  A5 c, c, 5400 w,
}

{: B.EQ_f ( label -- ) rlabel_f 0 cond_jump_instr_f, }
{: B.NE_f ( label -- ) rlabel_f 1 cond_jump_instr_f, }
{: B.HS_f ( label -- ) rlabel_f 2 cond_jump_instr_f, }
{: B.LO_f ( label -- ) rlabel_f 3 cond_jump_instr_f, }
{: B.MI_f ( label -- ) rlabel_f 4 cond_jump_instr_f, }
{: B.PL_f ( label -- ) rlabel_f 5 cond_jump_instr_f, }
{: B.HI_f ( label -- ) rlabel_f 8 cond_jump_instr_f, }
{: B.LS_f ( label -- ) rlabel_f 9 cond_jump_instr_f, }
{: B.GE_f ( label -- ) rlabel_f A cond_jump_instr_f, }
{: B.LT_f ( label -- ) rlabel_f B cond_jump_instr_f, }
{: B.GT_f ( label -- ) rlabel_f C cond_jump_instr_f, }
{: B.LE_f ( label -- ) rlabel_f D cond_jump_instr_f, }

\ x86-style branch names

{: call ( addr -- )
  $ xcall_size + X16 swap mov_rr,aa
  X16 push
  B.
}
{: call_f ( label -- )
  $ xcall_size + X16 swap mov_rr,aa
  X16 push
  B._f
}
{: call_rr ( reg -- )
  $ xcall_size + X16 swap mov_rr,aa
  X16 push
  5 lshift D61F x32,
}
{: jmp ( addr -- ) B. }
{: jmp_s ( addr -- ) B. }
{: jmp_f ( label -- ) B._f }
{: jmp_rr ( reg -- ) 5 lshift D61F x32, }
{: jmp_[aa] ( addr -- )
  0070 5800 x32, 0210 F940 x32, 0200 D61F x32, a,
}

{: jc ( addr -- ) X18 0 cmp_rr,s B.NE }
{: jnc ( addr -- ) X18 0 cmp_rr,s B.EQ }
{: jz ( addr -- ) B.EQ }
{: jnz ( addr -- ) B.NE }
{: jb ( addr -- ) B.LO }
{: jae ( addr -- ) B.HS }
{: jbe ( addr -- ) B.LS }
{: ja ( addr -- ) B.HI }
{: js ( addr -- ) B.MI }
{: jns ( addr -- ) B.PL }
{: jl ( addr -- ) B.LT }
{: jge ( addr -- ) B.GE }
{: jle ( addr -- ) B.LE }
{: jg ( addr -- ) B.GT }

{: jc_s ( addr -- ) X18 0 cmp_rr,s B.NE }
{: jnc_s ( addr -- ) X18 0 cmp_rr,s B.EQ }
{: jz_s ( addr -- ) B.EQ }
{: jnz_s ( addr -- ) B.NE }
{: jbe_s ( addr -- ) B.LS }
{: ja_s ( addr -- ) B.HI }
{: js_s ( addr -- ) B.MI }
{: jns_s ( addr -- ) B.PL }

{: jc_fs ( label -- ) X18 0 cmp_rr,s B.NE_f }
{: jnc_fs ( label -- ) X18 0 cmp_rr,s B.EQ_f }
{: jz_fs ( label -- ) B.EQ_f }
{: jnz_fs ( label -- ) B.NE_f }
{: js_fs ( label -- ) B.MI_f }
{: jns_fs ( label -- ) B.PL_f }
{: jae_fs ( label -- ) B.HS_f }
{: jb_fs ( label -- ) B.LO_f }
{: jbe_fs ( label -- ) B.LS_f }
{: ja_fs ( label -- ) B.HI_f }

{: ret X16 pop X16 jmp_rr }
{: inc_rr ( reg -- ) 1 ADD_r,s, }
{: dec_rr ( reg -- ) 1 SUB_r,s, }
{: clc X18 0 mov_rr,x }
{: stc X18 1 mov_rr,x }
{: cld }
{: std }

\ Shift instructions
\ immr sits above bit 15, so build the high half apart.

{: shl_rr,s ( reg imm -- )
  over dup 5 lshift or
  >r
  dup 3F swap - A lshift
  r> or
  swap
  0 swap - 3F and D340 or
  x32, drop
}

{: shr_rr,s ( reg imm -- )
  over dup 5 lshift or
  3F A lshift or
  swap
  D340 or
  x32, drop
}

{: shl_rr,cl ( reg -- )
  dup 5 lshift or 2000 or 9AC3 x32,
}

{: shr_rr,cl ( reg -- )
  dup 5 lshift or 2400 or 9AC3 x32,
}

{: sar_rr,cl ( reg -- )
  dup 5 lshift or 2800 or 9AC3 x32,
}

{: rcr_rr,1 ( reg -- )
  dup
  dup 5 lshift or 400 or
  swap 6 lshift 93C0 or
  x32,
}

{: rep_movsq }
{: rep_movsb }

{: cmpsb
  X16 X1 LDR_rl,[r],
  X17 X5 LDR_rl,[r],
  X16 X17 CMP_r,r,
  X1 1 add_rr,s
  X5 1 add_rr,s
}

{: mul_rr ( reg -- )
  X16 X0 MOV_r,r,
  dup 9B00 or 7E00 swap x32,
  dup 9BC0 or 7E02 swap x32,
  drop
}

{: div_rr ( reg -- )
  dup 9AC0 or 810 swap x32,
  dup 9B00 or 8202 swap x32,
  drop
  X0 X16 MOV_r,r,
}

{: idiv_rr ( reg -- )
  dup 9AC0 or 0C10 swap x32,
  dup 9B00 or 8202 swap x32,
  drop
  X0 X16 MOV_r,r,
}

{: not_rr 3E0 AA20 x32, }
{: neg_rr 3E0 CB00 x32, }

\ syscall

3F constant sys.read
40 constant sys.write
38 constant sys.open
39 constant sys.close
E2 constant sys.mprotect
D6 constant sys.brk
DC constant sys.clone
DD constant sys.execve
5D constant sys.exit

{: syscall ( n -- )
  X8 swap mov_rr,x
  X0 X5 MOV_r,r,
  SVC
}

\ Cross Compilation
\ The Seed language cannot be directly cross-compiled,
\ because the compile mode behavior of the newly defined
\ words cannot be executed on the host architecture.
\ However, there is only a handful of words with compile
\ mode behavior that differs from default, so we can
\ write those behaviors in host Seed and look them up from
\ an association list.

\ assembler macros


{: tos_load             \ top of data stack -> X0
X19 xcell sub_rr,s
X0 X19 mov_rr,[rr]
}

{: tos_store            \ X0 -> data stack
X19 X0 mov_[rr],rr
X19 xcell add_rr,s
}

{: binary
X3 X0 mov_rr,rr
tos_load
}

{: binary_cmp
binary
X0 X3 cmp_rr,rr
}

\ pointer to cross-compiled vocabulary
create xcurrent 0 w,

{: xlink ( a -- a )
xcell align
{ 0<> $ swap }~ a,
{ $ swap }~ q,
}~|

{: xlast ( -- a )
xcurrent }~ w@

{: xtraverse& ( a -( fail pend )- a )
w@ 0<>
offset @ +
'self &
dup
xcell+
}

