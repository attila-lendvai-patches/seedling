x' drop does

\ xcode_align_bytes is the instruction boundary. Emit it as a
\ target constant, then derive xcode_align_addr and xcode_align.
\ Target-side words; x marks this cross/target code-alignment
\ family. The host uses xcode_align_bytes with its own align.
native xcode_align_bytes
xcode_align_bytes xliteral
ret

{: xcode_align_addr
xcode_align_bytes + 1-
xcode_align_bytes 1- invert and }

{: xcode_align
here xcode_align_addr here - allot }

\ literal constructors

{: literal
xcode_align
0260 F900 x32,
2273 9100 x32,
dup FFFF and
dup 5 lshift FFFF and swap B rshift D280 or x32,
dup 10 rshift FFFF and
dup 5 lshift FFFF and swap B rshift F2A0 or x32,
dup 20 rshift FFFF and
dup 5 lshift FFFF and swap B rshift F2C0 or x32,
30 rshift FFFF and
dup 5 lshift FFFF and swap B rshift F2E0 or x32,
}

