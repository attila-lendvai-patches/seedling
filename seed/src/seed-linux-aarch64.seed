\ Mark a patched instruction as needing an icache sync.
native xicache_mark ( a -- )
binary
X16 XSYNC_FROM mov_rr,[aa]
X16 X3 cmp_rr,rr
8 jb_fs
XSYNC_FROM X3 mov_[aa],rr
8 rlabel
ret

\ Synchronize the instruction cache with code emitted since
\ the last sync. XSYNC_FROM is the low-water mark: it is
\ lowered when a previously emitted instruction is patched.
\ A 16-byte stride reaches every cache line because 16 bytes
\ is the smallest possible line size.
\ Contract: preserves X0-X3, X18, X19, X29, and SP; clobbers
\ X16/X17 and PSTATE flags.
native xicache_sync
X0 push
X1 push
X2 push
X3 push
X17 DP mov_rr,[aa]
X16 XSYNC_FROM mov_rr,[aa]
X16 X17 cmp_rr,rr
8 jae_fs
X1 0F mov_rr,x
X1 NOT_r,r,
X16 X1 and_rr,rr
9 label
X16 DC_CVAU
X16 10 add_rr,s
X16 X17 cmp_rr,rr
9 lb jb
DSB_ISH
X16 XSYNC_FROM mov_rr,[aa]
X16 X1 and_rr,rr
A label
X16 IC_IVAU
X16 10 add_rr,s
X16 X17 cmp_rr,rr
A lb jb
DSB_ISH
ISB
8 rlabel
X17 DP mov_rr,[aa]
XSYNC_FROM X17 mov_[aa],rr
X3 pop
X2 pop
X1 pop
X0 pop
ret

native }~fail
2 rlabel
2 label
X3 FAIL mov_rr,aa
3 label
ERR_SP movSP,[aa]	\ restore call stack
X2 pop			\ handler pointer in X2
X3 X2 cmp_rr,rr	\ compare with current effect's
X19 pop			\ X19 = previous handler address
X0 X2 mov_rr,[rr]
X2 X19 mov_[rr],rr	\ restore previous handler address
X19 X0 mov_rr,rr	\ X19 = current handler address
X0 pop			\ X0 = previous ERR_SP
ERR_SP X0 mov_[aa],rr	\ restore previous ERR_SP
3 lb jnz_s		\ next handler, if not found
X3 X19 mov_rr,rr	\ X3 = current handler address
X19 pop			\ restore data stack pointer
X0 X19 mov_rr,[rr]	\ restore TOS
x' xicache_sync call
X3 jmp_rr		\ continue with handler

