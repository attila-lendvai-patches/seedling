{: ' word find }~ drop

x' >lit does

{: {{
xcode_align
here 10 +
dup FFFF and 5 lshift 10 or
over FFFF and B rshift D280 or
x32,
10 rshift FFFF and
dup 5 lshift 10 or
swap B rshift F2A0 or
x32,
8FB0 F81F x32,
0 1400 }~ x32,

\ Close a quotation. Its body lives inline in the code stream
\ and may end with arbitrary-length data (e.g. a string
\ literal), so align to 4 bytes before patching the branch and
\ emitting the continuation: AArch64 instructions, and thus
\ branch targets and displacements, are 4-byte units.
{: }}
xcode_align
dup here swap - 4 + 2 rshift
swap 4 - >r
dup FFFF and swap drop
1400 r> x32!
0260 F900 x32,
2273 9100 x32,
87A0 F840 x32,
}

