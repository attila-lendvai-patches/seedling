{: neg_rr		48 c, F7 c, D8 or c, }

\ syscall

0  constant sys.read
1  constant sys.write
A  constant sys.mprotect
C  constant sys.brk
3C constant sys.exit

{: syscall ( n -- )
rax swap mov_rr,x
op_syscall
}

\ Cross Compilation
\ The Seed language cannot be directly cross-compiled,
\ because the compile mode behavior of the newly defined
\ words cannot be executed on the host architecture.
\ However, there is only a handful of words with compile
\ mode behavior that differs from default, so we can
\ write those behaviors in host Seed and look them up from
\ an association list.

\ assembler macros

{: tos_load             \ top of data stack -> rax
rbx xcell sub_rr,s
rax rbx mov_rr,[rr]
}

{: tos_store            \ rax -> data stack
rbx rax mov_[rr],rr
rbx xcell add_rr,s
}

{: binary
rcx rax mov_rr,rr
tos_load
}

{: binary_cmp
binary
rax rcx cmp_rr,rr
}

\ pointer to cross-compiled vocabulary
create xcurrent 0 w,

{: xlink ( a -- a )
xcell align
{ 0<> $ swap }~ a,
{ $ swap }~ q,
}~|

{: xlast ( -- a )
xcurrent }~ w@

{: xtraverse& ( a -( fail pend )- a )
w@ 0<>
offset @ +
'self &
dup
xcell+
}

{: xsearch ( a -( pad fail )- a )
xtraverse& xname_from_token +
pad s= cut }~ nip

{: xfind ( -( pad fail )- a )
xcurrent xsearch xname_from_token }~ -

\ target tick
{: x'
word xfind }~ w@

\ target pointer to callcomp
0 variable callcomp

\ target pointer to endcomp
0 variable endcomp

\ target pointer to execute
0 variable exec

\ target create
{: xcreate
xlast
xlink
xcurrent w!
here
0 a,
callcomp @
a,
word
pad
s,
0 c,
$ swap w!
}

\ target literal
{: xliteral ( x -( heap )- )
tos_store
rax swap mov_rr,xx
}

\ target address literal
{: xaliteral ( a -( heap )- )
tos_store
rax swap mov_rr,aa
}

{: x{{ ( -( heap )- a )
E8 c, 0 d, \ call forward
}~ here

{: x}} ( a -( heap )- )
dup here swap - swap xrel_size -
w!  \ 32 bit relative call offset
tos_store
rax pop
}

\ create association
{: assoc ( key value table -( heap )- )
dup @ link swap !
swap , , }

\ recall association
{: recall ( key table -- value )
traverse& @ third s= cut drop nip cell+ cell+ @ }

\ compile tail call to self
{: tail jmp }~fail

\ target host associations
0 variable xcomps

\ Compile mode behaviors for ends of computation

" }"		{ drop ret }~fail	xcomps assoc
" }~"		{ drop word xfind
		w@ jmp }~fail		xcomps assoc
" }~fail"	' tail			xcomps assoc
" }~|"		' tail			xcomps assoc
" }~self"	{ drop dup
		offset @ - jmp }~fail	xcomps assoc
" 'id}~|"	' tail			xcomps assoc

\ comments

" \\"		{ drop }~ \		xcomps assoc
" ("		{ drop }~ (		xcomps assoc

\ unnamed macros

" ["		{ drop ' interpret
		'id}~|			xcomps assoc


\ literal constructors

" ascii"	{ drop word pad
		c@ xliteral }		xcomps assoc
" '"		{ drop word xfind
		w@ xaliteral }		xcomps assoc
" 'self"	{ drop dup
		offset @ - xaliteral }	xcomps assoc

\ while loop
{: while
>r \ subject on return stack
dup >r \ predicate on return stack
\ predicate on data stack
{ r>drop r>drop r>drop } |
r> \ predicate on data stack
r> \ subject on data stack
swap
>r \ predicate on return stack
dup >r \ subject on return stack
execute \ execute subject
r> \ subject on data stack
r> \ predicate on data stack
swap }~self

\ The cross-compiler
{: xcompile
word
{ pad c@ 0= drop }
{ input word }
while
{ xfind w@
  { pad xcomps recall }
  { ' call }
}~|
{ pad s>number ' xliteral }
|
execute
}~self

\ cross string literal
{: xlits
bite
drop
{ bite ascii " <>
        { ascii \ = drop ' bite { A } }~|
        'id| c,
}~self
{ 0 }~ c,
}~|


\ quoted literals
" {"		{ drop 
		x{{ ' xcompile 'id | }~ x}}	xcomps assoc
" \""		{ drop x{{ xlits }~ x}}		xcomps assoc

\ Offsets in ELF header

0 variable headersLength
0 variable f_EntryPoint
0 variable f_ProgramHeaders
0 variable f_SizeInFile

{: 0c, 0 c, }

{: field here swap ! }

\ system variables
18000  dup    constant SEED
xcell+ dup    constant DP
xcell+ dup    constant TIB
xcell+ dup    constant FAIL
xcell+ dup    constant ERR_SP
xcell+ dup    constant DICTIONARY
xcell+ dup    constant BASE        \ of the number reader
1+     dup    constant EMIT_BUF    \ for the write syscall
1+     dup    constant PAD         \ temp buffer
20            constant PAD_LEN
PAD_LEN + dup constant TIB_BUF     \ line edit buffer
100           constant TIB_BUF_LEN
TIB_BUF_LEN + xalign
              constant EFFECTS

\ effect table slots
0 constant effect_emit
xcell constant effect_write
xcell 2 * constant effect_key
xcell 3 * constant effect_input
xcell 4 * constant effect_ok

\ effect pointer for cross-compiling
EFFECTS variable effects

\ The image end is a target offset. Both terms are multiples
\ of 10000, so the 16-bit difference stays the offset limit.
SEED IMAGE_BASE - constant image_limit

{: check_image_size
$ image_limit u<
}

