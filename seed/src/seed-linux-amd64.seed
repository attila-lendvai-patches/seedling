native 0=
rax rax or_rr,rr
2 label jnz
ret

native 0<>
rax rax or_rr,rr
2 label jz
ret

\ relations

native =
binary_cmp
2 label jnz
ret

native <>
binary_cmp
2 label jz
ret

native u>
binary_cmp
2 label jbe
ret

native u>=
binary_cmp
2 label jb
