\ Beginning of cross-compilation
create ELF

0 org

\ Signature
7F c, ascii E c, ascii L c, ascii F c,

\ Class 2, 64-bit
2 c,

\ Little-endian
1 c,

\ ELF version
1 c,

\ OS ABI
0c,

\ Extended ABI
0 q,

\ e_type: Elf file type (ET_EXEC = 2, executable)
2 w,

\ e_machine: Target architecture (EM_X86_64 = 62 = 0x3e, x86_64)
3E w,

\ e_version: Additional ELF version
1 d,

\ e_entry: Entry point, lower 16 bits
f_EntryPoint field
\ and the remaining 48 bits; the virtual address is 0x001xxxx
IMAGE_BASE a,

\ e_phoff: file offset of the program headers
f_ProgramHeaders field
0 q,

\ e_shoff: file offset of the section headers
0 q,

\ e_flags: unused
0 d,

\ e_ehsize: size of this elf header (struct ELF64_Ehdr)
40 w,

\ e_phentsize: size of program header entry
38 w,

\ e_phnum: Number of program header entries
1 w,

\ e_shentsize: Section header entry size
0 w,

\ e_shnum: Number of section header entries
0 w,

\ e_shstrndx: Index of string table section
0 w,

\
\ Program Headers
\

$ f_ProgramHeaders @ w!

\ p_type: program header type (PT_LOAD = 1)
1 d,

\ p_flags: program header flags: 7 = read + write + execute
7 d,

\ p_offset: loadable segment offset in the file
0 q,

\ p_vaddr: Virtual address, i.e. 10000
IMAGE_BASE a,

\ p_paddr: Physical address (ignored)
IMAGE_BASE a,

\ p_filesz: size in file
f_SizeInFile field
0 q,

\ p_memsz: size in memory
1 0000 u64,

\ p_align: alignment
1000 q,

\
\ Emit the machine code
\

$ f_EntryPoint @ w!

7 jmp_f \ jump over the initial dictionary

0 label! \ get heap top
sys.brk syscall
ret

1 label! \ low-level heap allocation of rcx bytes
rax push
rcx push
rdi 0 mov_rr,x
0 label call
rcx pop
rcx DP add_rr,[aa]
rax rcx cmp_rr,rr
2 jnc_fs
rdi rcx mov_rr,rr
0 label call
rdi DICTIONARY mov_rr,[aa] \ beginning of heap
rax rdi sub_rr,rr	\ calculate length of heap
rsi rax mov_rr,rr	\ move length to rsi
rdx 7 mov_rr,x		\ PROT_READ + PROT_WRITE + PROT_EXEC
sys.mprotect syscall
2 rlabel_fs!
rax pop
ret

\ runtime call site: E8 rel32 is xcall_size bytes
native callcomp
$ callcomp !
rcx xcall_size mov_rr,x
1 label call
rcx DP mov_rr,[aa]
rcx E8 mov_byte_[rr],x \ call
2 label!
rcx inc_rr
rax rcx sub_rr,rr
rax 4 sub_rr,s
rcx rax mov_[rr],er
rcx 4 add_rr,s
DP rcx mov_[aa],rr
tos_load
ret

x' callcomp does

\ runtime jump site: E9 rel32 is xjump_size bytes
native tailcomp
rcx xjump_size mov_rr,x
1 label call
rcx DP mov_rr,[aa]
rcx E9 mov_byte_[rr],x \ jmp
2 label jmp

native endcomp
$ endcomp !
x' tailcomp call
2 jmp_f

\ Failure frame, from ERR_SP up:
\   +0  handler pointer
\   +1  previous handler address
\   +2  previous ERR_SP
\   +3  saved data stack pointer
native }~fail
2 rlabel_f!
2 label!
rcx FAIL mov_rr,aa
3 label!
rsp ERR_SP mov_rr,[aa]	\ restore rsp
rdx pop			\ handler pointer in rdx
rcx rdx cmp_rr,rr	\ compare with current effect's
rbx pop			\ rbx = previous handler address
rax rdx mov_rr,[rr]
rdx rbx mov_[rr],rr	\ restore previous handler address
rbx rax mov_rr,rr	\ rbx = current handler address
rax pop			\ rax = previous ERR_SP
ERR_SP rax mov_[aa],rr	\ restore previous ERR_SP
3 label jnz_s		\ next handler, if not found
rcx rbx mov_rr,rr	\ rcx = current handler address
rbx pop			\ restore data stack pointer
rax rbx mov_rr,[rr]	\ restore TOS
rcx jmp_rr		\ continue with handler

x' endcomp does

native carry?
2 label jc
ret

