{: _sprout ( a -( sproutl )- )
' load
{ { " file not found" s. }~ cr }~ stderr
| sproutl }~ bye

\ the entry point is here; X20 keeps the process stack pointer
7 rlabel_f! \ the dictionary is ready here
7 label!
910003FD d, \ X29 = SP; SP stays 16-byte aligned

X20 mov_from_sp

X0 A mov_rr,x
BASE X0 mov_[aa],rl \ initialize numeral base
X5 0 mov_rr,x
0 label call \ get heap bottom
X19 X0 mov_rr,rr \ data stack starts at the current break
X2 X0 mov_rr,rr
X5 10000 mov_rr,x
X2 X5 add_rr,rr \ reserve 64K for the data stack
X5 X2 mov_rr,rr
sys.brk syscall \ extend the break over the data stack
DP X2 mov_[aa],rr \ initialize dictionary end
DICTIONARY X2 mov_[aa],rr \ and beginning
XSYNC_FROM X2 mov_[aa],rr \ no emitted code yet
X3 xcurrent @ mov_rr,aa \ initial vocabulary
X2 SPROUT mov_rr,aa \ sprout vocabulary pointer
X2 X3 mov_[rr],rr \ initialize it
CONTEXT X2 mov_[aa],rr \ initialize context vocabulary
CURRENT X2 mov_[aa],rr \ initialize current vocabulary

6 label!
X3 6 label mov_rr,aa
FAIL X3 mov_[aa],rr	\ initialize failure handler
X19 X0 mov_[rr],rr	\ save TOS
X19 push		\ save data stack ptr.
X3 mov_from_sp		\ return stack ptr. to X3
X3 18 sub_rr,s		\ bottom of handler frame
X3 push		\ circular reference
X3 6 label mov_rr,aa	\ this handler's address
X3 push		\ circular reference
X3 FAIL mov_rr,aa	\ failure handler
X3 push
ERR_SP mov_[aa],SP

\ initialize effects
X3 x' stdwrite mov_rr,aa
EFFECTS X3 mov_[aa],rr
X3 x' stdkey mov_rr,aa
EFFECTS 8 + X3 mov_[aa],rr
X3 x' stdinput mov_rr,aa
EFFECTS 10 + X3 mov_[aa],rr
\ division by zero exception
X3 x' stderrok mov_rr,aa
EFFECTS 20 + X3 mov_[aa],rr

\ initialize the user-defined exception slots
X16 1A200 mov_rr,x
X17 1F000 mov_rr,x
X3 x' bye mov_rr,aa
E label!
X16 X3 mov_[rr],rr
X16 xcell add_rr,s
X16 X17 cmp_rr,rr
E label jb
X16 1F000 mov_rr,x
X3 1A200 mov_rr,x
X16 X3 mov_[rr],rr

\ check arguments; X20 points at argc/argv
X0 X20 mov_rr,[rr]
X0 2 cmp_rr,s
7 jae_fs

\ execute sprout loop
x' sproutl call
x' bye jmp

7 rlabel_fs!
X0 X20 mov_rr,rr
X0 10 add_rr,s
X0 X0 mov_rr,[rr]
x' _sprout jmp

