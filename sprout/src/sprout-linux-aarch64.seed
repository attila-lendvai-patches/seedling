output \ this must be on the first line

\ This is the Sprout source for aarch64 Linux

\ Requirements
\ It can be compiled by any Seed that has at least 16 bit
\ cells and about 20 kilobytes of free RAM space available.

\ Assembler
\ This implements a very limited subset of the AArch64
\ assembly language and is only suited for compiling
\ code that lives in the virtual address range between
\ 10000 and 1FFFF inclusive.

\ Glossary
\ TOS: top of stack

\ Imlementation
\ X0 holds TOS, the top element of the data stack
\ X19 points to the data stack (but top element is in X0)
\ X3 is a scratch register
\ X29 is the call (shadow) stack pointer; X30 is the link
\ register, so X29 is the highest suitable register
\ SP is the hardware stack pointer and stays 16-byte aligned

hex

\ [port] IMAGE BASE
\ The target image is loaded at ximage_base and must stay below
\ 18000 (the system variables). Absolute addresses are emitted
\ as ximage_base + low16(image offset).
10000 constant ximage_base
ximage_base 10 rshift constant ximage_base_hi

\ [port] TARGET GEOMETRY (AArch64)
\ Values describe the target, not the compiling Sprout. Offsets
\ are in target bytes; the host may have a different cell size.
\
\   xcell_bits  target cell size in bits
\   xcelllog    log2(xcell); used by xcells
\   xcell       target cell size in bytes
\   xcell1-     xcell - 1
\   xcell_mask  align-up mask
\   xcells      ( n -- n*xcell )
\   xalign      ( a -- a' ) align address up to a cell
\   xcell+      ( a -- a+xcell )
\   xcode_align_bytes instruction alignment in bytes
\
\ Word entry layout (entry = link cell; 'current' points here):
\   +0              link
\   +xcell          token / xt (code address)
\   +2 cells        compile-mode behavior
\   +3 cells        zero-terminated name
\   code ...        aligned to xcode_align_bytes
\
\ xword_comp is the compile-behavior field offset.
\ xname_from_token is the name offset from the token cell.
\ xcall_size is the size of the stack-call sequence.
\ xquote_open_size is the size of the quotation opener emitted
\ by x{{.
\ xrel_size is the width of a relative branch field.
40 constant xcell_bits          \ 64 bits
3  constant xcelllog            \ for shifts
xcell_bits 3 rshift constant xcell
xcell 1 - constant xcell1-      \ 0007
xcell1- invert constant xcell_mask      \ FFF8
{: xcells  xcelllog lshift }
{: xalign  xcell1- + xcell_mask and }
{: xcell+  xcell + }

4 constant xcode_align_bytes
xcell 2 * constant xword_comp
xcell 2 * constant xname_from_token
10 constant xcall_size
10 constant xquote_open_size
4 constant xrel_size

\ Auxiliary functions for the Assembler

\ execute n times
{: times ( x n -- )
{ 0<> 1- >r dup >r execute r> r> }~self
{ drop }~ drop
}~|

\ extract least significant 8 bits
{: lsb		dup 8 rshift swap FF and }

\ Heap manipulation words for the assembler
\ note, that it should work on both little-endian and
\ big-endian architectures, with various cell sizes.

\ 16-bit little-endian comma
{: w,		lsb c, c, }

\ 32-bit little-endian comma
{: d,		{ lsb c, } 3 times c, }

\ 64-bit little-endian comma
{: q,		{ lsb c, } 7 times c, }

\ 64-bit virtual address comma
{: a,		w, ximage_base_hi w, 0 d, }

\ 16-bit little-endian fetch
{: w@		dup c@ swap 1+ c@ 8 lshift or }

\ 16-bit little-endian store
{: w!		dup >r 1+ >r lsb swap r> c! r> c! }

\ dump the tail of the heap for outputting the result
{: dump		here over - write drop }

{: bit_size_to_mask ( bit_size -- mask )
  1 swap lshift 1-
}

\ Offset between host and target addresses
0 variable offset

\ Assembler directives
{: $		here offset @ - }
{: org		here swap - offset ! }
{: align	{ dup $ swap 1- and 0<> drop 0 c, }~self ' drop }~|

\ Labels

\ 16 labels must be enough
create labels
10 cells allot

\
\ Naming convention
\
\ Labels can be forward/backward, short/long, and
\ relative/absolute.
\
\ Forward labels: _f suffix.
\
\ Short labels: _s suffix. Their distance must be within
\ (-128..127). Note that the _sf suffix combination is also
\ possible.
\
\ Relative labels: 'r' prefix in their name.
\
\ Backward labels: at the point when they are needed their
\ address is already known. We just store the current address
\ when they are defined, and read it from the label_cell when
\ they are needed.
\
\ Forward labels are trickier: we store the location where the
\ address of the future label is needed (typically as a
\ component of a machine code instruction), and when the point
\ is reached in the emission where we should point to, then the
\ label-defining counterpart will emit the address (or offset)
\ into the previously registered location. Important corollary:
\ forward labels can only have one reference to them.

\ label cell address
{: label_cell	cells labels + }

\
\ Backward labels
\

\ Store current address into a label
{: label!	$ swap label_cell ! }

\ Backward label address to stack (absolute)
{: label	label_cell @ }

\ Converts the address to a relative backward offset, divided by
\ 4 as expected by the ISA. Then shifts the offset into position
\ for the instruction, i.e. lshifts with low_bits bits, and
\ clears out high_bits number of bits from the left. Fails if
\ out of range.
{: label_offset ( addr high_bits low_bits -- off off)
  swap >r >r                    \ r: high_bits low_bits
  $ -                           \ offset
  2 rshift                      \ divided by 4
  r> lshift                     \ left by low_bits
  dup                           \ ds: offset, offset
  10 rshift                     \ ds: offset, offset_high16
  10 r> -                       \ 16 - high_bits
  bit_size_to_mask dup >r       \ mask; saved, too
  invert FFFF and               \ limit mask to 16 bits
                                \ ds: offset, o_high16, mask
  dup third and = drop \ fail if the lost part is not all 1's
  r> and                        \ drop opcode bits from upper16
  swap
  \ ds: offset_high16, offset (full size, but fine for w, )
}

\ Emit a relative jump offset (backward).
{: rlabel, ( offset_high16 offset high_opcode low_opcode -- )
  swap >r                       \ save high_opcode
  or w,                         \ write low
  r> or w,                      \ write high
}

\
\ Forward labels
\

\ Register relative offset location in the label until the
\ future definition of the label.
{: rlabel_f ( label -- )
  here swap label_cell !
}

\ This properly handles >16 bit forward offsets on hosts with at
\ least 32 bit cells, but it also doesn't fail on 16 bit hosts.
{: label_offset_f ( place -- offset_high16 offset )
  dup here swap - 2 rshift    \ ds: place, place, offset/4
  swap c@ 0F and lshift       \ shift the offset into place
  dup 10 rshift               \ ds: offset, offset_high16
  swap
}

\ Fill in relative offset
{: rlabel_f!
  label                      \ ds: place
  dup 2 + w@ >r               \ high_opcode
  dup 1 + c@ >r               \ low_opcode
  dup label_offset_f          \ place, offset_high16, offset
  r> or third w!              \ place, offset_high16
  r> or swap 2 + w!
}

{: rlabel rlabel_f! }
{: rlabel_fs! rlabel_f! }
{: rlabel_fs rlabel_f }

\ Register a 64 bit absolute forward location. Because we can
\ only assume 16 bit words in our host, we write out the upper
\ half of the 0x0001xxxx absolute base address, and store the
\ location of the lower half to be emitted by our label_f!
\ counterpart later.
{: label_f	here swap label_cell ! 0 w, ximage_base_hi w, 0 d, }

\ Emit absolute forward label (only the lower 16 bits of it!)
{: label_f!	label $ swap w! }

\ registers
0 constant X0
1 constant X1
2 constant X2
3 constant X3
4 constant X4
5 constant X5
6 constant X6
7 constant X7
8 constant X8
9 constant X9
A constant X10
B constant X11
C constant X12
D constant X13
E constant X14
F constant X15
10 constant X16
11 constant X17
12 constant X18
13 constant X19
14 constant X20
15 constant X21
16 constant X22
17 constant X23
18 constant X24
19 constant X25
1A constant X26
1B constant X27
1C constant X28
1D constant X29
1E constant X30
1F constant SP
1F constant XZR

\ x86-compatible register aliases used by the rest of the source
0  constant rax
13 constant rbx
3  constant rcx
2  constant rdx
1  constant rsi
4  constant rdi
5  constant rbp
1F constant rsp

\ Immediate construction

{: MOVZ_r,u16, ( reg imm -- )
  swap over FFFF and 5 lshift over or D2800000 or d,
  drop drop
}

{: MOVK_r,u16, ( reg imm -- )
  swap over FFFF and 5 lshift over or F2A00000 or d,
  drop drop
}

{: mov_rr,x ( reg imm -- )
  swap
  over FFFF and 5 lshift over or D2800000 or d,
  over 10 rshift FFFF and 5 lshift over or F2A00000 or d,
  over 20 rshift FFFF and 5 lshift over or F2C00000 or d,
  over 30 rshift FFFF and 5 lshift over or F2E00000 or d,
  drop drop
}

{: mov_rr,xx ( reg imm -- ) mov_rr,x }

{: mov_rr,aa ( reg addr -- )
  swap
  over FFFF and 5 lshift over or D2800000 or d,
  1 5 lshift over or F2A00000 or d,
  drop drop
}

\ Register to register operations

{: MOV_r,r, ( dst src -- )
  10 lshift swap or AA0003E0 or d,
}

{: ADD_r,r, ( dst src -- )
  10 lshift swap dup 5 lshift or or 8B000000 or d,
}

{: ADDS_r,r, ( dst src -- )
  10 lshift swap dup 5 lshift or or AB000000 or d,
}

{: SUB_r,r, ( dst src -- )
  10 lshift swap dup 5 lshift or or CB000000 or d,
}

{: SUBS_r,r, ( dst src -- )
  10 lshift swap dup 5 lshift or or EB000000 or d,
}

{: AND_r,r, ( dst src -- )
  10 lshift swap dup 5 lshift or or 8A000000 or d,
}

{: ORR_r,r, ( dst src -- )
  10 lshift swap dup 5 lshift or or AA000000 or d,
}

{: ANDS_r,r, ( dst src -- )
  10 lshift swap dup 5 lshift or or EA000000 or d,
}


{: EOR_r,r, ( dst src -- )
  10 lshift swap dup 5 lshift or or CA000000 or d,
}

\ Register to immediate operations

{: ADD_r,s, ( reg imm -- )
  A lshift swap dup dup 5 lshift or or or 91000000 or d,
}

{: ADDS_r,s, ( reg imm -- )
  A lshift swap dup dup 5 lshift or or or B1000000 or d,
}

{: SUB_r,s, ( reg imm -- )
  A lshift swap dup dup 5 lshift or or or D1000000 or d,
}

{: SUBS_r,s, ( reg imm -- )
  A lshift swap dup dup 5 lshift or or or F1000000 or d,
}

{: CMP_r,r, ( left right -- )
  10 lshift swap 5 lshift or EB00001F or d,
}

{: CMP_r,s, ( reg imm -- )
  A lshift swap 5 lshift or F100001F or d,
}

\ AArch64 has no flag-setting ORR; emit ORR plus CMP dst,#0.
{: ORRS_r,r, ( dst src -- )
  over over ORR_r,r,
  swap 0 CMP_r,s,
  drop
}

\ Memory operations

{: LDR_r,[r], ( dst base -- )
  5 lshift swap or F9400000 or d,
}

{: STR_r,[r], ( base src -- )
  swap 5 lshift swap or F9000000 or d,
}

{: LDR_er,[r], ( dst base -- )
  5 lshift swap or B9400000 or d,
}

{: STR_er,[r], ( base src -- )
  swap 5 lshift swap or B9000000 or d,
}

{: LDR_rl,[r], ( dst base -- )
  5 lshift swap or 39400000 or d,
}

{: STR_rl,[r], ( base src -- )
  swap 5 lshift swap or 39000000 or d,
}

{: STRB_16,[r], ( base -- )
  5 lshift 10 or 39000000 or d,
}
\ These move the call-stack pointer (X29), not the hardware SP:
\ SP must stay 16-byte aligned for the kernel.
{: mov_from_sp ( dst -- )
  910003A0 or d,
}

{: mov_to_sp ( src -- )
  5 lshift 91000000 or 1D or d,
}

{: movSP,[aa] ( addr -- )
  X16 swap mov_rr,aa X17 X16 LDR_r,[r], X17 mov_to_sp
}

{: mov_[aa],SP ( addr -- )
  X16 swap mov_rr,aa X17 mov_from_sp X16 X17 STR_r,[r],
}

{: set_carry_add 9A9F37F2 d, }
{: set_carry_sub 9A9F27F2 d, }
{: set_carry_ne 9A9F07F2 d, }

\ Basic x86-compatible macro names used throughout

{: mov_rr,rr ( dst src -- ) MOV_r,r, }
{: mov_rl,rl ( dst src -- ) MOV_r,r, }
{: mov_er,er ( dst src -- ) MOV_r,r, }

{: mov_[rr],rr ( base src -- ) STR_r,[r], }
{: mov_[rr],er ( base src -- ) STR_er,[r], }
{: mov_[rr],rl ( base src -- ) STR_rl,[r], }
{: mov_er,[rr] ( dst base -- ) LDR_er,[r], }
{: mov_rl,[rr] ( dst base -- ) LDR_rl,[r], }
{: mov_rr,[rr] ( dst base -- ) LDR_r,[r], }

{: mov_byte_[rr],x ( base imm -- )
  swap >r X16 swap MOVZ_r,u16, r> STRB_16,[r],
}

{: mov_[aa],rr ( addr src -- )
  >r X16 swap mov_rr,aa r> X16 swap mov_[rr],rr
}

{: mov_[aa],rl ( addr src -- )
  >r X16 swap mov_rr,aa r> X16 swap mov_[rr],rl
}

{: mov_rl,[aa] ( dst addr -- )
  X16 swap mov_rr,aa X16 LDR_rl,[r],
}

{: mov_rr,[aa] ( dst addr -- )
  X16 swap mov_rr,aa X16 LDR_r,[r],
}

{: add_rr,rr ( dst src -- ) ADDS_r,r, set_carry_add }
{: add_rr,s ( reg imm -- ) ADDS_r,s, set_carry_add }
{: add_rr,[aa] ( reg addr -- )
  swap >r X16 swap mov_rr,aa X16 X16 LDR_r,[r], r> X16 ADD_r,r,
}
{: sub_rr,s ( reg imm -- ) SUBS_r,s, set_carry_sub }
{: sub_rr,rr ( dst src -- ) SUBS_r,r, set_carry_sub }
{: sbb_rr,rr ( dst src -- )
  \ dst = dst - src - carry (the x86 CF kept in X18)
  >r
  dup dup
  r>
  SUB_r,r,
  drop
  X18
  SUB_r,r,
}
{: adds_rr,rr ( dst src -- ) ADDS_r,r, }
{: adds_rr,s ( reg imm -- ) ADDS_r,s, }
{: subs_rr,rr ( dst src -- ) SUBS_r,r, }
{: subs_rr,s ( reg imm -- ) SUBS_r,s, }
{: cmp_rr,s ( reg imm -- ) CMP_r,s, }
{: cmp_rr,rr ( left right -- ) CMP_r,r, }
{: cmp_rr,[rr] ( left base -- )
  swap >r X16 swap LDR_r,[r], r> X16 CMP_r,r,
}
{: cmp_rl,[rr] ( reg base -- )
  swap >r X16 swap LDR_rl,[r], r> X16 CMP_r,r,
}
{: and_rr,rr ( dst src -- ) ANDS_r,r, }
{: or_rr,rr ( dst src -- ) ORRS_r,r, }
{: xor_rr,rr ( dst src -- )
  over over EOR_r,r,
  swap 0 CMP_r,s,
  drop
}

{: SVC D4000001 d, }
{: int_x SVC }

{: push ( reg -- ) 1F8FA0 or F81F8C00 or d, }
{: pop ( reg -- ) F84087A0 or d, }

\ Instruction cache maintenance. Code written to the heap
\ must be cleaned to the point of unification and the
\ instruction cache invalidated before it can be executed.
{: DC_CVAU ( reg -- ) D50B7B20 or d, }
{: IC_IVAU ( reg -- ) D50B7520 or d, }
{: DSB_ISH D5033B9F d, }
{: ISB D5033FDF d, }
{: NOT_r,r, ( reg -- ) dup 10 lshift swap or AA2003E0 or d, }

\ Branch instructions

{: B.   ( addr  -- ) 6 0 label_offset 1400 0 rlabel, }
{: BL   ( addr  -- ) 6 0 label_offset 9400 0 rlabel, }

{: cond_jump_instr
  8 5 label_offset 5400
}

{: B.EQ ( addr -- ) cond_jump_instr 0 rlabel, }
{: B.NE ( addr -- ) cond_jump_instr 1 rlabel, }
{: B.HS ( addr -- ) cond_jump_instr 2 rlabel, }
{: B.LO ( addr -- ) cond_jump_instr 3 rlabel, }
{: B.MI ( addr -- ) cond_jump_instr 4 rlabel, }
{: B.PL ( addr -- ) cond_jump_instr 5 rlabel, }
{: B.VS ( addr -- ) cond_jump_instr 6 rlabel, }
{: B.VC ( addr -- ) cond_jump_instr 7 rlabel, }
{: B.HI ( addr -- ) cond_jump_instr 8 rlabel, }
{: B.LS ( addr -- ) cond_jump_instr 9 rlabel, }
{: B.GE ( addr -- ) cond_jump_instr A rlabel, }
{: B.LT ( addr -- ) cond_jump_instr B rlabel, }
{: B.GT ( addr -- ) cond_jump_instr C rlabel, }
{: B.LE ( addr -- ) cond_jump_instr D rlabel, }

{: B._f   ( label -- ) rlabel_f A0 c, 0 c, 1400 w, }
{: BL_f   ( label -- ) rlabel_f A0 c, 0 c, 9400 w, }

{: cond_jump_instr_f, ( high_low_bits low_opcode -- )
  A5 c, c, 5400 w,
}

{: B.EQ_f ( label -- ) rlabel_f 0 cond_jump_instr_f, }
{: B.NE_f ( label -- ) rlabel_f 1 cond_jump_instr_f, }
{: B.HS_f ( label -- ) rlabel_f 2 cond_jump_instr_f, }
{: B.LO_f ( label -- ) rlabel_f 3 cond_jump_instr_f, }
{: B.MI_f ( label -- ) rlabel_f 4 cond_jump_instr_f, }
{: B.PL_f ( label -- ) rlabel_f 5 cond_jump_instr_f, }
{: B.HI_f ( label -- ) rlabel_f 8 cond_jump_instr_f, }
{: B.LS_f ( label -- ) rlabel_f 9 cond_jump_instr_f, }
{: B.VS_f ( label -- ) rlabel_f 6 cond_jump_instr_f, }
{: B.VC_f ( label -- ) rlabel_f 7 cond_jump_instr_f, }
{: B.GE_f ( label -- ) rlabel_f A cond_jump_instr_f, }
{: B.LT_f ( label -- ) rlabel_f B cond_jump_instr_f, }
{: B.GT_f ( label -- ) rlabel_f C cond_jump_instr_f, }
{: B.LE_f ( label -- ) rlabel_f D cond_jump_instr_f, }

\ x86-compatible branch names

{: call ( addr -- )
  $ xcall_size + ximage_base + X16 swap mov_rr,aa
  X16 push
  B.
}
{: call_f ( label -- )
  $ xcall_size + ximage_base + X16 swap mov_rr,aa
  X16 push
  B._f
}
{: call_rr ( reg -- )
  $ xcall_size + ximage_base + X16 swap mov_rr,aa
  X16 push
  5 lshift D61F0000 or d,
}
{: jmp ( addr -- ) B. }
{: jmp_s ( addr -- ) B. }
{: jmp_f ( label -- ) B._f }
{: jmp_rr ( reg -- ) 5 lshift D61F0000 or d, }
{: jmp_[aa] ( addr -- )
  58000070 d, F9400210 d, D61F0200 d, a,
}

{: jc ( addr -- ) X18 0 cmp_rr,s B.NE }
{: jnc ( addr -- ) X18 0 cmp_rr,s B.EQ }
{: jz ( addr -- ) B.EQ }
{: jnz ( addr -- ) B.NE }
{: jb ( addr -- ) B.LO }
{: jae ( addr -- ) B.HS }
{: jbe ( addr -- ) B.LS }
{: ja ( addr -- ) B.HI }
{: js ( addr -- ) B.MI }
{: jns ( addr -- ) B.PL }
{: jl ( addr -- ) B.LT }
{: jge ( addr -- ) B.GE }
{: jle ( addr -- ) B.LE }
{: jg ( addr -- ) B.GT }

{: jc_s ( addr -- ) X18 0 cmp_rr,s B.NE }
{: jnc_s ( addr -- ) X18 0 cmp_rr,s B.EQ }
{: jz_s ( addr -- ) B.EQ }
{: jnz_s ( addr -- ) B.NE }
{: jbe_s ( addr -- ) B.LS }
{: jae_s ( addr -- ) B.HS }
{: jb_s ( addr -- ) B.LO }
{: ja_s ( addr -- ) B.HI }
{: js_s ( addr -- ) B.MI }
{: jns_s ( addr -- ) B.PL }

{: jc_fs ( label -- ) X18 0 cmp_rr,s B.NE_f }
{: jnc_fs ( label -- ) X18 0 cmp_rr,s B.EQ_f }
{: jz_fs ( label -- ) B.EQ_f }
{: jnz_fs ( label -- ) B.NE_f }
{: js_fs ( label -- ) B.MI_f }
{: jns_fs ( label -- ) B.PL_f }
{: jae_fs ( label -- ) B.HS_f }
{: jb_fs ( label -- ) B.LO_f }
{: jbe_fs ( label -- ) B.LS_f }
{: ja_fs ( label -- ) B.HI_f }

{: ret X16 pop X16 jmp_rr }
{: inc_rr ( reg -- ) 1 ADDS_r,s, }
{: dec_rr ( reg -- ) 1 SUBS_r,s, }
{: clc X18 0 mov_rr,x }
{: stc X18 1 mov_rr,x }
{: cld }
{: std }

\ Shift instructions

{: shl_rr,s ( reg imm -- )
  dup 3F swap - A lshift >r
  0 swap - 3F and 10 lshift r> or
  over dup 5 lshift or or D3400000 or d, drop
}

{: shr_rr,s ( reg imm -- )
  dup 10 lshift >r
  drop
  3F A lshift r> or
  over dup 5 lshift or or D3400000 or d, drop
}

{: shl_rr,cl ( reg -- )
  dup 5 lshift or 30000 or 9AC02000 or d,
}

{: shr_rr,cl ( reg -- )
  dup 5 lshift or 30000 or 9AC02400 or d,
}

{: sar_rr,cl ( reg -- )
  dup 5 lshift or 30000 or 9AC02800 or d,
}

{: rcr_rr,1 ( reg -- )
  \ reg = (reg >> 1) | ((carry & 1) << 63)
  dup 5 lshift or D341FC00 or d,	\ LSR reg, reg, #1
  92400250 d,				\ AND X16, X18, #1
  D3410210 d,				\ LSL X16, X16, #63
  dup dup 5 lshift or 100000 or
  AA000000 or d,	\ ORR reg, reg, X16
  drop
}

{: rep_movsq }
{: rep_movsb }

{: cmpsb
  X16 X1 LDR_rl,[r],
  X17 X5 LDR_rl,[r],
  X16 X17 CMP_r,r,
  X1 1 ADD_r,s,	\ must not clobber the comparison flags
  X5 1 ADD_r,s,
}

{: mul_rr ( reg -- )
  X16 X0 MOV_r,r,
  dup 10 lshift 200 or 9B007C00 or d,
  10 lshift 200 or 2 or 9BC07C00 or d,
}

{: div_rr ( reg -- )
  dup 10 lshift 10 or 9AC00800 or d,
  10 lshift 200 or 2 or 9B008000 or d,
  X0 X16 MOV_r,r,
}

{: idiv_rr ( reg -- )
  dup 10 lshift 10 or 9AC00C00 or d,
  10 lshift 200 or 2 or 9B008000 or d,
  X0 X16 MOV_r,r,
}

{: not_rr AA2003E0 d, }
{: neg_rr CB0003E0 d, }

\ syscall

3F constant sys.read
40 constant sys.write
38 constant sys.open
39 constant sys.close
E2 constant sys.mprotect
D6 constant sys.brk
DC constant sys.clone
DD constant sys.execve
5D constant sys.exit

{: syscall ( n -- )
  X8 swap mov_rr,x
  X0 X5 MOV_r,r,
  SVC
}

\ Cross Compilation
\ The Sprout language cannot be directly cross-compiled,
\ because the compile mode behavior of the newly defined
\ words cannot be executed on the host architecture.
\ However, there is only a handful of words with compile
\ mode behavior that differs from default, so we can
\ write those behaviors in host Sprout and look them up from
\ an association list.

\ assembler macros


{: tos_load               \ top of data stack -> rax
rbx xcell sub_rr,s
rax rbx mov_rr,[rr]
}

{: tos_store              \ rax -> data stack
rbx rax mov_[rr],rr
rbx xcell add_rr,s
}

{: binary
rcx rax mov_rr,rr
tos_load
}

{: binary_cmp
binary
rax rcx cmp_rr,rr
}

\ AArch64 scalar floating point helpers
0 constant D0
1 constant D1
2 constant D2
3 constant D3
4 constant D4
5 constant D5
6 constant D6
7 constant D7
8 constant D8
9 constant D9

\ move a 64-bit constant into a D register
{: d_const ( bits dreg -- )
  swap X16 swap mov_rr,x
  9E670200 or d,
}

\ move between general purpose and FP registers
{: FMOV_d,x ( dreg xreg -- ) 5 lshift swap or 9E670000 or d, }
{: FMOV_x,d ( xreg dreg -- ) 5 lshift swap or 9E660000 or d, }

\ three-operand FP arithmetic
{: fop3, ( dst left right base -- )
  >r
  10 lshift swap 5 lshift or swap or
  r> or d,
}
{: FADD_d,d,d ( dst left right -- ) 1E602800 fop3, }
{: FSUB_d,d,d ( dst left right -- ) 1E603800 fop3, }
{: FMUL_d,d,d ( dst left right -- ) 1E600800 fop3, }
{: FDIV_d,d,d ( dst left right -- ) 1E601800 fop3, }

\ two-operand FP operations
{: fun2, ( dst src base -- )
  >r
  dup 5 lshift swap drop or
  r> or d,
}
{: FABS_d,d ( dst src -- ) 1E60C000 fun2, }
{: FNEG_d,d ( dst src -- ) 1E614000 fun2, }
{: FRINTM_d,d ( dst src -- ) 1E654000 fun2, }
{: FRINTZ_d,d ( dst src -- ) 1E65C000 fun2, }

\ FP comparison
{: FCMP_d,d ( left right -- )
  10 lshift swap 5 lshift or 1E602000 or d, }
{: FCMP_d,0 ( reg -- ) 5 lshift 1E602008 or d, }

\ conversions
{: SCVTF_d,x ( dreg xreg -- ) 5 lshift swap or 9E620000 or d, }
{: FCVTMS_x,d ( xreg dreg -- ) 5 lshift swap or 9E700000 or d, }
{: FCVTZS_x,d ( xreg dreg -- ) 5 lshift swap or 9E780000 or d, }

\ extra conditional branches for the FP code
{: jle_fs ( label -- ) B.LE_f }
{: jlt_fs ( label -- ) B.LT_f }
{: jge_fs ( label -- ) B.GE_f }
{: jgt_fs ( label -- ) B.GT_f }
{: jvs_fs ( label -- ) B.VS_f }
{: jvc_fs ( label -- ) B.VC_f }

\ helpers for the FP comparisons
{: fcmp2 ( left right -- left )
binary
D0 X0 FMOV_d,x
D1 X3 FMOV_d,x
D0 D1 FCMP_d,d
}
{: fcmp1 ( f -- f )
D0 X0 FMOV_d,x
D0 FCMP_d,0
}

