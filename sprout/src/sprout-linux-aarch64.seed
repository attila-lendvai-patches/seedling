x' >lit does

postpone undef

{: _undef undef 'id 'id }

{: ' word ' find ' _undef | }~ drop

x' >lit does

{: {{
xcode_align
here 10 + dup FFFF and 5 lshift 10 or D2800000 or d,
10 rshift FFFF and 5 lshift 10 or F2A00000 or d,
F81F8FB0 d,
14000000 }~ d,

\ Close a quotation. Its body lives inline in the code stream
\ and may end with arbitrary-length data (e.g. a string
\ literal), so align to 4 bytes before patching the branch and
\ emitting the continuation: AArch64 instructions, and thus
\ branch targets and displacements, are 4-byte units.
{: }}
xcode_align
dup here swap - 4 + 2 rshift 3FFFFFF and 14000000 or swap 4 -
dup xicache_mark
d!
F9000260 d,
91002273 d,
F84087A0 d,
}

