}~ drop

\ postponed colon definition
{: {::
word find drop \ address of jmp instruction
1+ \ address of jmp relative address
dup
4 + \ address of jmp anchor
here swap -
swap ! \ TODO: adjust interpret mode behavior address, too
here ' compile 'id|
}~ drop

\ change compile mode behavior
{: does ( x -( heap )- )
last cell+ cell+ }~ !

\ make most recently definted word immediate
{: immediate ( -( heap )- )
' execute }~ does

\ find address in context vocabulary
{: name ( x -( fail )- a )
context @ traverse& third u< cut cell+ cell+ nip }~ nip

\ scratch frame functions

\ end address of the current frame
{: ftop ( -( fbot )- a )
fbot dup cell- @ }~ +

\ previous frame base address
{: pfbot ( -( fbot fail )- a )
fbot 14 - @ }~ 0<>

\ end address of the previous frame
{: pftop ( -( fbot fail )- a )
pfbot dup cell- @ }~ +

\ numeral functions

\ convert integer to digit
{: >digit ( n -- c )
{ 9 u<= ascii 0 }
{ [ ascii A A - xliteral ] }
| }~ +

\ emit positive number w/o trailing space
{: _. ( n -( emit )- )
{ 0<> base c@ u/mod _. >digit }~ emit
' drop
}~|

\ emit unsigned number w/ trailing space
{: u. ( n -( emit )- )
{ 0= ascii 0 emit }~ drop
' _.
| }~ space

\ emit signed number w/ trailing space
{: . ( n -( emit )- )
' 0>= { ascii - emit }~ negate | }~ u.

\ execute n times
{: times ( x n -- )
{ 0<> 1- >r dup >r { cut }~fail | r> r> }~self
{ drop }~ drop
}~|

\ number of significant digits
{: _digits ( -( base )- n )
35 int>f \ mantissa digits
_fbase flog2 f/
f>int 1- }

\ emit floating point number w/ trailing space
{: f. ( f -( emit )- )
fdup flog2 _fbase flog2 f/ f>int \ exponent
dup >r \ exponent saved
int>f _fbase fswap f^ f/ \ normalization
r> swap
_fbase _digits negate int>f f^ fhalf f+ \ rounding
{ _fbase }~ f< { _fbase f/ swap 1+ }~ swap |
fdup f>int >digit emit ascii . emit
{ ffrac _fbase f* fdup f>int >digit }~ emit
_digits times
drop
ascii e emit
{ 0>= ascii + emit } 'id|
}~ . 

\ input functions

\ get next word from the input buffer
{:: word ( -( tib pad fail )- )
tib @ wsskip
pad
{ over c@ printable over c! pad
[ PAD_LEN xliteral ] + u< 1+ swap 1+ swap }~self
{ 0 swap c! tib }~ !
}~|

\ input, ignoring lines beginning with #
{: _input
{ ' input { cut }~fail | tib @ c@ ascii # = drop }~self
'id}~|

\ compiler

{:: compile
{ word pad c@ 0= drop ' _input { cut }~fail | }~self
'id|
' find
{ { { pad ascii . index drop s>float ' fliteral }
    { pad s>number ' literal }
  }~|
  { undef 'id }
}~|
| execute
}~ compile \ TODO: why }~self doesn't work?

\ ok effect
{: stderrok
{ "  ok" s. }~ cr
}~ stderr

\ sprout vocabulary
native sprout
ecx SPROUT mov_rr,aa
CONTEXT ecx mov_[aa],rr
ret

\ UTF-8 functions

{: _u8dec ( x c n -( fail )- c )
{ 0<> 1- >r 6 lshift >r dup >r execute 3F and
  r> swap r> swap or r> }~self
'id|
drop }~ nip

{: u8decode ( x -( fail )- c )
dup >r execute r> swap
{ { { 7F u<= }~ nip
    { DF u<= 1F and 1 }~ _u8dec
  }~|
  { EF u<= 0F and 2 }~ _u8dec
}~|
{ F7 u<= 07 and 3 }~ _u8dec
}~|

\ UTF-8 bite
{: u8bite ( -( tib fail )- c )
' bite }~ u8decode

\ UTF-8 character literal
{: utf8 ( -- c )
tib @ wsskip tib !
}~ u8bite

x' >lit does

\ UTF-8 key
{: u8key ( -( key )- c )
' key }~ u8decode

{: _bite ( a -- a c )
dup 1+ swap }~ c@

\ UTF-8 length
{: u8length ( a -( fail )- n )
0 swap
{ nonempty ' _bite u8decode drop swap 1+ swap }~self
'id| }~ drop

{: _u8emit ( c -( emit )- )
3F and 80 or }~ emit

\ UTF-8 emit
{: u8emit ( c -( emit fail )- )
{ { { 7F <= }~ emit
    { 7FF <= dup 6 rshift C0 or emit }~ _u8emit
  }~|
  { FFFF <= dup C rshift E0 or emit dup 
    6 rshift _u8emit }~ _u8emit
}~|
{ 10FFFF <= dup 12 rshift F0 or emit dup
  C rshift _u8emit dup 6 rshift _u8emit }~ _u8emit
}~|

\ debugging

\ forget a word and what was defined after it
{: forget
word
current @ context @ =
search dictionary u>=
cell- dup @ current @ ! dp }~ !

\ output data stack content
native .s
ecx effects @ xcell+ mov_rr,aa \ stack bottom
3 label!
ebx ecx cmp_rr,rr
x' cr jc
4 jz_fs
ecx push
tos_store
eax ecx mov_rr,[rr]
x' . call
ecx pop
ecx xcell add_rr,s
3 label jmp
4 rlabel_fs!
tos_store
x' . call
x' cr jmp

\ Sprout loop
{: sproutl
{
{ _input
  { interpret ok }
  { { "  fail" s. }~ cr }~ stderr
}~|
{ { " division by 0" s. }~ cr }~ stderr
' 0/  catch
}~self
'id}~|

\ output object code
{: output
' sproutl 'id ' ok }~ handle

\ process a file as a sprout source
{: load ( a -( fail sproutl )- )
' output swap }~ readfile

\ execute a sprout file
{: _sprout ( a -( sproutl )- )
' load
{ { " file not found" s. }~ cr }~ stderr
| sproutl }~ bye

$ 177F w, \ FPU control word, round towards -inf

7 rlabel_f! \ the dictionary is ready here
7 label!

finit
ebx swap mov_rr,aa \ FPU control word address in ebx
ebx fldcw_[rr]
eax A mov_rr,x
BASE eax mov_[aa],rl \ initialize numeral base
edi 0 mov_rr,x
0 label call \ get heap bottom
DP eax mov_[aa],rr \ initialize dictionary end
DICTIONARY eax mov_[aa],rr \ and beginning
ebx effects @ mov_rr,aa \ initialize stack pointer
ecx xcurrent @ mov_rr,aa \ initial vocabulary
edx SPROUT mov_rr,aa \ sprout vocabulary pointer
edx ecx mov_[rr],rr \ initialize it
CONTEXT edx mov_[aa],rr \ initialize context vocabulary
CURRENT edx mov_[aa],rr \ initialize current vocabulary

6 label!
ebx eax mov_[rr],rr	\ save TOS
ebx push		\ save data stack ptr.
ecx esp mov_rr,rr	\ return stack ptr. to ecx
ecx 3 xcells sub_rr,s	\ bottom of handler frame
ecx push		\ circular reference
ecx 6 label mov_rr,aa	\ this handler's address
ecx push		\ circular reference
ecx FAIL mov_rr,aa	\ failure handler
ecx push
ERR_SP esp mov_[aa],rr	\ set ERR_SP

\ initialize effects
ecx x' stdwrite mov_rr,aa
EFFECTS ecx mov_[aa],rr
ecx x' stdkey mov_rr,aa
EFFECTS 4 + ecx mov_[aa],rr
ecx x' stdinput mov_rr,aa
EFFECTS 8 + ecx mov_[aa],rr
\ division by zero exception
ecx x' stderrok mov_rr,aa
EFFECTS 10 + ecx mov_[aa],rr

\ check arguments
ecx 10 mov_rr,x
ecx esp add_rr,rr
ecx ecx mov_rr,[rr]
ecx 2 cmp_rr,s
7 jnc_fs

\ execute sprout loop
x' sproutl call
x' bye jmp

7 rlabel_fs!
tos_store
eax 18 mov_rr,x
eax esp add_rr,rr
eax eax mov_rr,[rr]
x' _sprout jmp

$ f_SizeInFile @ w!

ELF dump

bye
