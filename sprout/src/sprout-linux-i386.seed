                        { 0F c, 8E c, rlabel, }
                        maybe_rs }
{: jg			{ 7F c, c, }
                        { 0F c, 8F c, rlabel, }
                        maybe_rs }
{: ret			C3 c, }
{: push			50 + c, }
{: pop			58 + c, }
{: inc_rr		FF c, C0 or c, }
{: dec_rr		FF c, C8 or c, }
{: clc			F8 c, }
