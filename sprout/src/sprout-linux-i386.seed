native
here
' xcompile
' drop
}~|

\ Beginning of cross-compilation
create ELF

0 org

\ Signature
7F c, ascii E c, ascii L c, ascii F c,

\ Class 1, 32-bit
1 c,

\ Little-endian
1 c,

\ ELF version
1 c,

\ OS ABI
0c,

\ Extended ABI
0 q,

\ e_type: ET_EXEC = 2
2 w,

\ e_machine: EM_386 = 3
3 w,

\ e_version
1 d,

\ e_entry
f_EntryPoint field
0 w, 1 w,

\ e_phoff
f_ProgramHeaders field
0 d,

\ e_shoff
f_SectionHeaders field
0 d,

\ e_flags
0 d,

\ e_ehsize
34 w,

\ e_phentsize
20 w,

\ e_phnum
1 w,

\ e_shentsize
0 w,

\ e_shnum
0 w,

\ e_shstrndx
0 w,

\
\ Program Headers
\

$ f_ProgramHeaders @ w!

\ p_type: PT_LOAD = 1
1 d,

\ p_offset
0 d,

\ p_vaddr: 10000
0 w, 1 w,

\ p_paddr
0 w, 1 w,

\ p_filesz
f_SizeInFile field
0 d,

\ p_memsz
0 w, 1 w,

\ p_flags: 7 = read + write + execute
7 d,

\ p_align
1000 d,

\
\ Emit the machine code
\

$ f_EntryPoint @ w!

7 jmp_f \ jump over the initial dictionary

0 label! \ get heap top
sys.brk syscall
ret

1 label! \ low-level heap allocation of ecx bytes
eax push
ecx push
edi 0 mov_rr,x
0 label call
ecx pop
ecx DP add_rr,[aa]
eax ecx cmp_rr,rr
2 jnc_fs
edi ecx mov_rr,rr
0 label call
edi DICTIONARY mov_rr,[aa] \ beginning of heap
eax edi sub_rr,rr	\ calculate length of heap
ecx eax mov_rr,rr	\ move length to ecx
edx 7 mov_rr,x		\ PROT_READ + PROT_WRITE + PROT_EXEC
sys.mprotect syscall
2 rlabel_fs!
eax pop
ret

native callcomp
$ callcomp !
ecx 5 mov_rr,x
1 label call
ecx DP mov_rr,[aa]
ecx E8 mov_byte_[rr],x \ call
2 label!
ecx inc_rr
eax ecx sub_rr,rr
eax 4 sub_rr,s
ecx eax mov_[rr],er
ecx 4 add_rr,s
DP ecx mov_[aa],rr
tos_load
ret

x' callcomp does

native tailcomp
ecx 5 mov_rr,x
1 label call
ecx DP mov_rr,[aa]
ecx E9 mov_byte_[rr],x \ jmp
2 label jmp

native endcomp
$ endcomp !
x' tailcomp call
2 jmp_f

native }~fail
2 rlabel_f!
2 label!
ecx FAIL mov_rr,aa
$ catch !
3 label!
esp ERR_SP mov_rr,[aa]	\ restore esp
edx pop			\ handler pointer in edx
edx edx or_rr,rr	\ check for zero
4 jnz_fs
edx pop			\ finally pointer in edx
ecx push		\ save current effect
edx call_rr		\ execute finally
ecx pop			\ restore current effect
eax pop
ERR_SP eax mov_[aa],rr	\ restore previous ERR_SP
3 label jmp

4 rlabel_fs!
ecx edx cmp_rr,rr	\ compare with current effect's
ebx pop			\ ebx = previous handler address
eax edx mov_rr,[rr]
edx ebx mov_[rr],rr	\ restore previous handler address
ebx eax mov_rr,rr	\ ebx = current handler address
eax pop			\ eax = previous ERR_SP
ERR_SP eax mov_[aa],rr	\ restore previous ERR_SP
3 label jnz		\ next handler, if not found
ecx ebx mov_rr,rr	\ ecx = current handler address
ebx pop			\ restore data stack pointer
eax ebx mov_rr,[rr]	\ restore TOS
ecx jmp_rr		\ continue with handler

x' endcomp does

postpone word

postpone find

native carry?
2 label jc
ret

\ arithmetic filters

native 0=
eax eax or_rr,rr
