output \ this must be on the first line

\ This is the Sprout source for i386 Linux

\ Requirements
\ It can be compiled by any Seed that has at least 16 bit
\ cells and about 20 kilobytes of free RAM space available.

\ Assembler
\ This implements a very limited subset of the i386
\ assembly language and is only suited for compiling
\ code that lives in the virtual address range between
\ 10000 and 17FFF inclusive.

\ Glossary
\ TOS: top of stack

\ Imlementation
\ EAX holds TOS, the top element of the data stack
\ EBX points to the data stack (but top element is in EAX)
\ ECX is a scratch register
\ ESP is the call stack

hex

\ Auxiliary functions for the Assembler

\ execute n times
{: times ( x n -- )
{ 0<> 1- >r dup >r execute r> r> }~self
{ drop }~ drop
}~|

\ extract least significant 8 bits
{: lsb		dup 8 rshift swap FF and }

\ Heap manipulation words for the assembler
\ note, that it should work on both little-endian and
\ big-endian architectures, with various cell sizes.

\ 16-bit little-endian comma
{: w,		lsb c, c, }

\ 32-bit little-endian comma
{: d,		{ lsb c, } 3 times c, }

\ 8-byte little-endian comma
{: q,		{ lsb c, } 7 times c, }

\ 32-bit virtual address comma
{: a,		w, 1 w, }

\ 16-bit little-endian fetch
{: w@		dup c@ swap 1+ c@ 8 lshift or }

\ 16-bit little-endian store
{: w!		dup >r 1+ >r lsb swap r> c! r> c! }

\ dump the tail of the heap for outputting the result
{: dump		here over - write drop }

\ Offset between host and target addresses
0 variable offset

\ Assembler directives
{: $		here offset @ - }
{: org		here swap - offset ! }
{: align	{ dup $ swap 1- and 0<> drop 0 c, }~self ' drop }~|

\ Labels

\ 8 labels must be enough
create labels
8 cells allot

\
\ Naming convention
\
\ Labels can be forward/backward, short/long, and
\ relative/absolute.
\
\ Forward labels: _f suffix.
\
\ Short labels: _s suffix. Their distance must be within
\ (-128..127). Note that the _sf suffix combination is also
\ possible.
\
\ Relative labels: 'r' prefix in their name.
\
\ There are 3 classes of label primitives:
\
\ - label defining primitives: ! suffix
\
\ - label emitting primitives: , suffix
\
\ - other label primitives without any suffix put the label on
\   the stack in some form.
\
\ Backward labels: at the point when they are needed their
\ address is already known. We just store the current address
\ when they are defined, and read it from the label_cell when
\ they are needed.
\
\ Forward labels are trickier: we store the location where the
\ address of the future label is needed (typically as a
\ component of a machine code instruction), and when the point
\ is reached in the emission where we should point to, then the
\ label-defining counterpart will emit the address (or offset)
\ into the previously registered location. Important corollary:
\ forward labels can only have one reference to them.

\ label cell address
{: label_cell	cells labels + }

\
\ Backward labels
\

\ Store current address into a label
{: label!	$ swap label_cell ! }

\ Backward label address to stack (absolute)
{: label	label_cell @ }

{: label_offset ( n n -- n)
  \ stack: label-address instr-size
  $ + -
}

\ Emit a relative jump offset (backward). There exists only rel8
\ and rel32 relative offsets in the x86 ISA.
{: rlabel,	4 label_offset w, FFFF w, }
{: rlabel_s,	1 label_offset c, }

\
\ Forward labels
\

\ Register relative offset location
{: rlabel_f,	here swap label_cell ! 0 d, }
{: rlabel_fs,	here swap label_cell ! 0 c, }

\ Fill in relative offset
{: rlabel_f!	label dup here swap - 4 - swap w! }
{: rlabel_fs!	label dup here swap - 1- swap c! }

\ Register a 32 bit absolute forward location. Because we can
\ only assume 16 bit words in our host, we write out the upper
\ half of the 0x0001xxxx absolute base address, and store the
\ location of the lower half to be emitted by our label_f!
\ counterpart later.
{: label_f,	here swap label_cell ! 0 w, 1 w, }

\ Emit absolute forward label (only the lower 16 bits of it!)
{: label_f!	label $ swap w! }

\ multiply by 8
{: 8*		3 lshift }

\ Fails if the backward offset doesn't fit into a signed byte.
{: short_rlabel? ( n n -( fail )- n )
  \ stack: address short_instr_size -> address offset
  over swap         \ dup address for the failure handler
  label_offset      \ x byte instr, backward label
  0 80 - u>=        \ fail if not within negative 7 bits range
                    \ leaves the relative offset on the stack
}

\ Receives two blocks, and executes the short one if the
\ backward offset fits into a signed byte.
{: select_rel_emitter
  \ address short_block long_block short_instr_size
  >r >r                 \ address short
  swap r> swap r>       \ short long address short_instr_size

  {
    short_rlabel?
    \ short long address short_offset
    nip                 \ drop address
    nip                 \ drop long block
    swap execute        \ execute short with offset at top
  }
  {
    drop                \ short_instr_size
    swap execute        \ long block with address at the top
    drop                \ short
  }
}~|

\ Most instructions using rel8 are 2 bytes long, but not all of
\ them, so we keep around the more general select_rel_emitter
\ abstraction.
{: maybe_rs 2 select_rel_emitter }

\ registers
0 constant eax
1 constant ecx
2 constant edx
3 constant ebx
4 constant esp
5 constant ebp
6 constant esi
7 constant edi

\ Opcodes

{: mov_rr,x		swap B8 + c, d, }
{: mov_rr,aa		swap B8 + c, w, 1 w, }
{: mov_rr,rr		89 c, 8* + C0 or c, }
{: mov_rl,rl		88 c, 8* + C0 or c, }
{: mov_er,er		89 c, 8* + C0 or c, }
{: mov_byte_[rr],x      C6 c, swap c, c, }
{: mov_[rr],rr		89 c, 8* + c, }
{: mov_[rr],er		89 c, 8* + c, }
{: mov_er,[rr]		8B c, swap 8* + c, }
{: mov_[rr],rl		88 c, 8* + c, }
{: mov_rl,[rr]		8A c, swap 8* + c, }
{: mov_rr,[rr]		8B c, swap 8* + c, }
{: mov_[aa],rr		89 c, 8* 4 + c, 25 c, w, 1 w, }
{: mov_[aa],rl		88 c, 8* 4 + c, 25 c, w, 1 w, }
{: mov_rl,[aa]		8A c, swap 8* 4 + c, 25 c, w, 1 w, }
{: mov_rr,[aa]		8B c, swap 8* 4 + c, 25 c, w, 1 w, }
{: int_x		CD c, c, }
{: add_rr,rr		01 c, 8* + C0 or c, }
{: add_rr,s		83 c, swap C0 + c, c, }
{: add_rr,[aa]		03 c, swap 8* 4 + c, 25 c, w, 1 w, }
{: sub_rr,s		83 c, swap E8 + c, c, }
{: sub_rr,rr		29 c, 8* + C0 or c, }
{: sbb_rr,rr		19 c, 8* + C0 or c, }
{: cmp_rr,s		83 c, swap F8 + c, c, }
{: cmp_rr,rr		39 c, 8* + C0 or c, }
{: cmp_rr,[rr]		3B c, swap 8* + c, }
{: cmp_rl,[rr]		3A c, swap 8* + c, }
{: and_rr,rr		21 c, 8* + C0 or c, }
{: or_rr,rr		09 c, 8* + C0 or c, }
{: xor_rr,rr		31 c, 8* + C0 or c, }
{: call			E8 c, rlabel, }
{: call_f		E8 c, rlabel_f, }
{: call_rr		FF c, D0 or c, }
{: jmp                  { EB c, c, }
                        { E9 c, rlabel, }
                        maybe_rs }
{: jmp_f		E9 c, rlabel_f, }
{: jmp_[aa]		FF c, 24 c, 25 c, w, 1 w, }
{: jmp_rr		FF c, E0 or c, }
{: jc_fs		72 c, rlabel_fs, }
{: jnc_fs		73 c, rlabel_fs, }
{: jz_fs		74 c, rlabel_fs, }
{: jnz_fs		75 c, rlabel_fs, }
{: js_fs		78 c, rlabel_fs, }
{: jns_fs		79 c, rlabel_fs, }
{: jc                   { 72 c, c, }
                        { 0F c, 82 c, rlabel, }
                        maybe_rs }
{: jb			}~ jc
{: jnc                  { 73 c, c, }
                        { 0F c, 83 c, rlabel, }
                        maybe_rs }
{: jae			}~ jnc
{: jz                   { 74 c, c, }
                        { 0F c, 84 c, rlabel, }
                        maybe_rs }
{: jnz                  { 75 c, c, }
                        { 0F c, 85 c, rlabel, }
                        maybe_rs }
{: jbe			{ 76 c, c, }
                        { 0F c, 86 c, rlabel, }
                        maybe_rs }
{: ja			{ 77 c, c, }
                        { 0F c, 87 c, rlabel, }
                        maybe_rs }
{: js			{ 78 c, c, }
                        { 0F c, 88 c, rlabel, }
                        maybe_rs }
{: jns			{ 79 c, c, }
                        { 0F c, 89 c, rlabel, }
                        maybe_rs }
