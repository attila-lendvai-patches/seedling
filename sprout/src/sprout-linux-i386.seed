\ syscall

3  constant sys.read
4  constant sys.write
5  constant sys.open
6  constant sys.close
7D constant sys.mprotect
2D constant sys.brk
78 constant sys.clone
2  constant sys.fork
BE constant sys.vfork
B  constant sys.execve
1  constant sys.exit

{: syscall ( n -- )
ebx push
ebx edi mov_rr,rr
eax swap mov_rr,x
  80 int_x
ebx pop
}

\ Cross Compilation
\ The Sprout language cannot be directly cross-compiled,
\ because the compile mode behavior of the newly defined
\ words cannot be executed on the host architecture.
\ However, there is only a handful of words with compile
\ mode behavior that differs from default, so we can
\ write those behaviors in host Sprout and look them up from
\ an association list.

\ assembler macros

20 constant xcell_bits		\ 32 bits
2  constant xcelllog		\ for shifts
xcell_bits 3 rshift
   constant xcell		\ byte size of the target's word
xcell 1 -
   constant xcell1-		\ 3
xcell1- invert 1+
   constant xcell_mask          \ FFFC

{: xcells
  xcelllog lshift		\ 8 *
}

{: xalign
  xcell1- + xcell_mask and
}

{: xcell+
  xcell +
}

{: tos_load               \ top of data stack -> eax
ebx xcell sub_rr,s
eax ebx mov_rr,[rr]
}

{: tos_store              \ eax -> data stack
ebx eax mov_[rr],rr
ebx xcell add_rr,s
}

{: binary
ecx eax mov_rr,rr
tos_load
}

{: binary_cmp
binary
eax ecx cmp_rr,rr
}

{: unary_fp
ebx eax mov_[rr],rr
ebx fld_[rr]
}

{: binary_fp
unary_fp
ebx xcell sub_rr,s
ebx fld_[rr]
}

{: value_fp
ebx fstp_[rr]
eax ebx mov_rr,[rr]
}

{: binary_fcmp
binary_fp
fucomip
ffree
fincstp
}

{: unary_fcmp
unary_fp
fldz
fucomip
ffree
fincstp
}

\ pointer to cross-compiled vocabulary
create xcurrent 0 w,

{: xlink ( a -- a )
xcell align
{ 0<> $ swap }~ a,
{ $ swap }~ d,
}~|

{: xlast ( -- a )
xcurrent }~ w@

{: xtraverse& ( a -( fail pend )- a )
w@ 0<>
offset @ +
'self &
dup
xcell+
}

{: xsearch ( a -( pad fail )- a )
xtraverse& 8 +
pad s= cut }~ nip

{: xfind ( -( pad fail )- a )
xcurrent xsearch 8 }~ -

{: undef ( -( pad emit )- )
pad s. "  undefined" s. cr }~ bye

{: xfind' ( -( pad bye )- a )
' xfind ' undef }~|

\ target tick
{: x'
word xfind' }~ w@

\ target pointer to callcomp
0 variable callcomp

\ target pointer to endcomp
0 variable endcomp

\ target pointer to execute
0 variable exec

\ target pointer to catch
0 variable catch

\ target create
{: xcreate
xlast
xlink
xcurrent w!
here
0 a,
callcomp @
a,
word
pad
s,
0 c,
$ swap w!
}

\ target literal
{: xliteral ( x -( heap )- )
tos_store
eax swap mov_rr,x
}

\ target address literal
{: xaliteral ( a -( heap )- )
tos_store
eax swap mov_rr,aa
}

{: x{{ ( -( heap )- a )
E8 c, 0 d, \ call forward
}~ here

{: x}} ( a -( heap )- )
dup here swap - swap 4 - w!
tos_store
eax pop
}

\ create association
{: assoc ( key value table -( heap )- )
dup @ link swap !
swap , , }

\ recall association
{: recall ( key table -- value )
traverse& @ third s= cut drop nip cell+ cell+ @ }

\ compile tail call to self
{: tail jmp }~fail

\ target host associations
0 variable xcomps

\ Compile mode behaviors for ends of computation

" }"		{ drop ret }~fail	xcomps assoc
" }~"		{ drop word xfind'
		w@ jmp }~fail		xcomps assoc
" }~fail"	' tail			xcomps assoc
" }~|"		' tail			xcomps assoc
" }~self"	{ drop dup
		offset @ - jmp }~fail	xcomps assoc
" 'id}~|"	' tail			xcomps assoc

\ comments

" \\"		{ drop }~ \		xcomps assoc
" ("		{ drop }~ (		xcomps assoc

\ unnamed macros

" ["		{ drop ' interpret
		'id}~|			xcomps assoc


\ literal constructors

" ascii"	{ drop word pad
		c@ xliteral }		xcomps assoc
" '"		{ drop word xfind'
		w@ xaliteral }		xcomps assoc
" 'self"	{ drop dup
		offset @ - xaliteral }	xcomps assoc

\ while loop
{: while
>r \ subject on return stack
dup >r \ predicate on return stack
\ predicate on data stack
{ r>drop r>drop r>drop } |
r> \ predicate on data stack
r> \ subject on data stack
swap
>r \ predicate on return stack
dup >r \ subject on return stack
execute \ execute subject
r> \ subject on data stack
r> \ predicate on data stack
swap }~self

\ The cross-compiler
{: xcompile
word
{ pad c@ 0= drop }
{ input word }
while
{ xfind w@
  { pad xcomps recall }
  { ' call }
}~|
{
  { pad s>number ' xliteral }
  ' undef
}~|
|
execute
}~self

\ cross string literal
{: xlits
bite
drop
{ bite ascii " <>
        { ascii \ = drop ' bite { A } }~|
        'id| c,
}~self
{ 0 }~ c,
}~|


\ quoted literals
" {"		{ drop 
		x{{ ' xcompile 'id | }~ x}}	xcomps assoc
" \""		{ drop x{{ xlits }~ x}}		xcomps assoc

\ Offsets in ELF header

0 variable headersLength
0 variable f_EntryPoint
0 variable f_ProgramHeaders
0 variable f_SectionHeaders
0 variable f_SizeInFile
0 variable f_TotalFileSize
0 variable f_StringTableVA
0 variable f_StringTableOffset

{: 0c, 0 c, }

{: field here swap ! }

18000  dup    constant SPROUT
xcell+ dup    constant DP
xcell+ dup    constant TIB
xcell+ dup    constant FAIL
xcell+ dup    constant ERR_SP
xcell+ dup    constant CONTEXT
xcell+ dup    constant CURRENT
xcell+ dup    constant DICTIONARY
xcell+ dup    constant FRAME
xcell+ dup    constant ENV
xcell+ dup    constant BASE        \ of the number reader
1+     dup    constant EMIT_BUF    \ for the write syscall
1+     dup    constant PAD         \ temp buffer
20            constant PAD_LEN
PAD_LEN + dup constant TIB_BUF     \ line edit buffer
100           constant TIB_BUF_LEN
TIB_BUF_LEN + xalign
              constant EFFECTS

\ effect pointer for cross-compiling
EFFECTS variable effects

\ native word definition
{: native
xcreate
}

\ postpone colon definition
{: postpone
native
E9 c, 0 d, \ jmp forward
}

\ effect definition
{: effect
native
effects @ dup xcell+ effects !
jmp_[aa]
}

\ exception definition
{: exception
native
effects @ dup xcell+ effects !
ecx swap mov_rr,aa
catch @ jmp
}

\ constant definition
{: constant
native
tos_store
eax swap mov_rr,x
ret
}

\ address definition (because of 16-bit cells)
{: address
native
tos_store
eax swap mov_rr,aa
ret
}

\ change compile mode behavior
{: does
xlast
8 +
offset @ +
w! }

{: immediate
exec @ }~ does

\ alias
{: alias
xcreate
word
xfind'
dup
w@ \ interpret mode behavior
swap
xcell+
w@ \ compile mode behavior
does
xlast
xcell+
offset @ +
w! }

\ target quotation
{: {
$ ' xcompile 'id}~|

\ postponed colon definition
{: {::
word xfind' w@ offset @ + \ host address of jmp instruction
1+ \ host address of jmp relative address
dup
4 + \ host address of jmp anchor
here swap -
swap w!
$ ' xcompile 'id|
}~ drop \ TODO: adjust interpret mode behavior address, too

